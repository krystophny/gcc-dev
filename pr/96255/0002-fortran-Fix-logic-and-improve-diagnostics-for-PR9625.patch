From 27b26611af75578efc1932a281b7ab6a45f7f4b5 Mon Sep 17 00:00:00 2001
From: Christopher Albert <albert@tugraz.at>
Date: Sun, 9 Nov 2025 09:43:26 +0100
Subject: [PATCH 2/2] fortran: Fix logic and improve diagnostics for PR96255

Fix shadow variable creation logic to only create shadows when there is
an actual type kind mismatch, not for every iterator with a type spec.
Previously, shadow variables were created unconditionally, which would
cause issues even for simple cases like:

  do concurrent (integer :: i=1:10)

where 'i' is not declared in outer scope (BT_UNKNOWN). Now shadows are
only created when v->ts.kind != ts.kind.

Also improve the error message for shadow variable creation failure,
replacing the unprofessional "whoops" with a descriptive message.

	PR fortran/96255

Signed-off-by: Christopher Albert <albert@tugraz.at>
---
 gcc/fortran/match.cc | 74 ++++++++++++++++++++++++--------------------
 1 file changed, 41 insertions(+), 33 deletions(-)

diff --git a/gcc/fortran/match.cc b/gcc/fortran/match.cc
index c9597a0bd0c..0ef5758a922 100644
--- a/gcc/fortran/match.cc
+++ b/gcc/fortran/match.cc
@@ -2673,28 +2673,32 @@ match_forall_header (gfc_forall_iterator **phead, gfc_expr **mask)
       /* If index-name does not have a type and type spec, then update the
 	 type spec in both the expr and symtree.  Otherwise, create a new
 	 shadow index-name.  */
+      new_iter->shadow = false;
       v = new_iter->var;
       if (v->ts.type == BT_UNKNOWN)
 	{
 	  v->ts.type = v->symtree->n.sym->ts.type = BT_INTEGER;
 	  v->ts.kind = v->symtree->n.sym->ts.kind = ts.kind;
 	}
+      else if (v->ts.kind != ts.kind)
+	{
+	  name = (char *) alloca (strlen (v->symtree->name) + 2);
+	  strcpy (name, "_");
+	  strcat (name, v->symtree->name);
+	  if (gfc_get_sym_tree (name, NULL, &st, false) != 0)
+	    gfc_internal_error ("Failed to create shadow variable for "
+				"FORALL/DO CONCURRENT index-name");
 
-      name = (char *) alloca (strlen (v->symtree->name) + 2);
-      strcpy (name, "_");
-      strcat (name, v->symtree->name);
-      if (gfc_get_sym_tree (name, NULL, &st, false) != 0)
-	gfc_internal_error ("whoops");
-
-      v = gfc_get_expr ();
-      v->where = gfc_current_locus;
-      v->expr_type = EXPR_VARIABLE;
-      v->ts.type = st->n.sym->ts.type = ts.type;
-      v->ts.kind = st->n.sym->ts.kind = ts.kind;
-      st->n.sym->forall_index = true;
-      v->symtree = st;
-      gfc_replace_expr (new_iter->var, v);
-      new_iter->shadow = true;
+	  v = gfc_get_expr ();
+	  v->where = gfc_current_locus;
+	  v->expr_type = EXPR_VARIABLE;
+	  v->ts.type = st->n.sym->ts.type = ts.type;
+	  v->ts.kind = st->n.sym->ts.kind = ts.kind;
+	  st->n.sym->forall_index = true;
+	  v->symtree = st;
+	  gfc_replace_expr (new_iter->var, v);
+	  new_iter->shadow = true;
+	}
 
       gfc_convert_type (new_iter->start, &ts, 1);
       gfc_convert_type (new_iter->end, &ts, 1);
@@ -2720,30 +2724,34 @@ match_forall_header (gfc_forall_iterator **phead, gfc_expr **mask)
 	      gfc_expr *v;
 	      gfc_symtree *st;
 
+	      new_iter->shadow = false;
 	      v = new_iter->var;
 	      if (v->ts.type == BT_UNKNOWN)
 		{
 		  v->ts.type = v->symtree->n.sym->ts.type = BT_INTEGER;
 		  v->ts.kind = v->symtree->n.sym->ts.kind = ts.kind;
 		}
-
-	      name = (char *) alloca (strlen (v->symtree->name) + 2);
-	      strcpy (name, "_");
-	      strcat (name, v->symtree->name);
-	      if (gfc_get_sym_tree (name, NULL, &st, false) != 0)
-		gfc_internal_error ("whoops");
-
-	      v = gfc_get_expr ();
-	      v->expr_type = EXPR_VARIABLE;
-	      v->ts.type = ts.type;
-	      v->ts.kind = ts.kind;
-	      v->where = gfc_current_locus;
-	      st->n.sym->ts.type = ts.type;
-	      st->n.sym->ts.kind = ts.kind;
-	      st->n.sym->forall_index = true;
-	      v->symtree = st;
-	      gfc_replace_expr (new_iter->var, v);
-	      new_iter->shadow = true;
+	      else if (v->ts.kind != ts.kind)
+		{
+		  name = (char *) alloca (strlen (v->symtree->name) + 2);
+		  strcpy (name, "_");
+		  strcat (name, v->symtree->name);
+		  if (gfc_get_sym_tree (name, NULL, &st, false) != 0)
+		    gfc_internal_error ("Failed to create shadow variable for "
+					"FORALL/DO CONCURRENT index-name");
+
+		  v = gfc_get_expr ();
+		  v->expr_type = EXPR_VARIABLE;
+		  v->ts.type = ts.type;
+		  v->ts.kind = ts.kind;
+		  v->where = gfc_current_locus;
+		  st->n.sym->ts.type = ts.type;
+		  st->n.sym->ts.kind = ts.kind;
+		  st->n.sym->forall_index = true;
+		  v->symtree = st;
+		  gfc_replace_expr (new_iter->var, v);
+		  new_iter->shadow = true;
+		}
 
 	      gfc_convert_type (new_iter->start, &ts, 1);
 	      gfc_convert_type (new_iter->end, &ts, 1);
-- 
2.51.2

