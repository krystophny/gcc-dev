 	  gfc_resolve_forall (code, ns, forall_save);
-	  forall_flag = 2;
+	  if (code->op == EXEC_FORALL)
+	    forall_flag = 2;
+	  else if (code->op == EXEC_DO_CONCURRENT)
+	    gfc_do_concurrent_flag = 2;
 	}
