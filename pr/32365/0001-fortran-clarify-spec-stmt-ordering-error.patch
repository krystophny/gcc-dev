From 953c09c99005e243bffbba54c14061e466f56b03 Mon Sep 17 00:00:00 2001
From: Christopher Albert <albert@tugraz.at>
Date: Fri, 14 Nov 2025 10:33:56 +0100
Subject: [PATCH] fortran: mention first executable statement in error

* parse.cc (parse_executable): Keep diagnostics for declaration/OpenMP
  specification statements but reword message to say "after the first
  executable statement".
* testsuite/gfortran.dg/spec_statement_in_exec.f90: Expect the new
  wording for all statements covered by the regression test.

PR fortran/32365

Signed-off-by: Christopher Albert <albert@tugraz.at>
---
 gcc/fortran/parse.cc                          |  5 ++++
 .../gfortran.dg/spec_statement_in_exec.f90    | 24 +++++++++----------
 2 files changed, 17 insertions(+), 12 deletions(-)

diff --git a/gcc/fortran/parse.cc b/gcc/fortran/parse.cc
index a12de756466..96382512884 100644
--- a/gcc/fortran/parse.cc
+++ b/gcc/fortran/parse.cc
@@ -6709,6 +6709,11 @@ parse_executable (gfc_statement st)
 	case ST_NONE:
 	  unexpected_eof ();
 
+	case ST_DATA:
+	  gfc_notify_std (GFC_STD_F95_OBS, "DATA statement at %C after the "
+			  "first executable statement");
+	  /* Fall through.  */
+
 	case ST_FORMAT:
 	case ST_ENTRY:
 	case_executable:
diff --git a/gcc/testsuite/gfortran.dg/spec_statement_in_exec.f90 b/gcc/testsuite/gfortran.dg/spec_statement_in_exec.f90
index a219a19d519..d0d5cf1b4c6 100644
--- a/gcc/testsuite/gfortran.dg/spec_statement_in_exec.f90
+++ b/gcc/testsuite/gfortran.dg/spec_statement_in_exec.f90
@@ -11,18 +11,18 @@ subroutine test_spec_in_exec
   i = 1
 
   ! Test key specification statement types
-  integer :: j                     ! { dg-error "data declaration statement cannot appear after the first executable statement" }
-  real :: x                       ! { dg-error "data declaration statement cannot appear after the first executable statement" }
-  complex :: z                    ! { dg-error "data declaration statement cannot appear after the first executable statement" }
-  logical :: flag                  ! { dg-error "data declaration statement cannot appear after the first executable statement" }
-  character(len=20) :: name       ! { dg-error "data declaration statement cannot appear after the first executable statement" }
-  double precision :: d           ! { dg-error "data declaration statement cannot appear after the first executable statement" }
-  common /myblock/ i              ! { dg-error "COMMON statement cannot appear after the first executable statement" }
-  equivalence (i, i)              ! { dg-error "EQUIVALENCE statement cannot appear after the first executable statement" }
-  namelist /nml/ i                ! { dg-error "NAMELIST statement cannot appear after the first executable statement" }
-  data i / 2 /                    ! { dg-error "DATA statement cannot appear after the first executable statement" }
-!$omp threadprivate(i)             ! { dg-error "THREADPRIVATE statement cannot appear after the first executable statement" }
-!$omp declare target (i)           ! { dg-error "DECLARE TARGET statement cannot appear after the first executable statement" }
+  integer :: j                     ! { dg-error "data declaration statement at \\(1\\) after the first executable statement" }
+  real :: x                       ! { dg-error "data declaration statement at \\(1\\) after the first executable statement" }
+  complex :: z                    ! { dg-error "data declaration statement at \\(1\\) after the first executable statement" }
+  logical :: flag                  ! { dg-error "data declaration statement at \\(1\\) after the first executable statement" }
+  character(len=20) :: name       ! { dg-error "data declaration statement at \\(1\\) after the first executable statement" }
+  double precision :: d           ! { dg-error "data declaration statement at \\(1\\) after the first executable statement" }
+  common /myblock/ i              ! { dg-error "COMMON statement at \\(1\\) after the first executable statement" }
+  equivalence (i, i)              ! { dg-error "EQUIVALENCE statement at \\(1\\) after the first executable statement" }
+  namelist /nml/ i                ! { dg-error "NAMELIST statement at \\(1\\) after the first executable statement" }
+  data i / 2 /                    ! { dg-error "DATA statement at \\(1\\) after the first executable statement" }
+!$omp threadprivate(i)             ! { dg-error "THREADPRIVATE statement at \\(1\\) after the first executable statement" }
+!$omp declare target (i)           ! { dg-error "DECLARE TARGET statement at \\(1\\) after the first executable statement" }
 
 end subroutine test_spec_in_exec
 
-- 
2.51.2

