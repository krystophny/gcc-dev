+    !$omp threadprivate (t1)	! { dg-error "\\\\\\!\\\\\\$OMP THREADPRIVATE statement cannot appear in the execution part" }
   end subroutine f2
   subroutine f3
     use m
     implicit none
     integer :: j
     j = 1
-    !$omp declare reduction (foo:real:omp_out = omp_out + omp_in)	! { dg-error "Unexpected" }
+    !$omp declare reduction (foo:real:omp_out = omp_out + omp_in)	! { dg-error "\\\\\\!\\\\\\$OMP DECLARE REDUCTION statement cannot appear in the execution part" }
   end subroutine f3
