From e695caec0a4258180c1a2d0b690f7ed1a5e50d5f Mon Sep 17 00:00:00 2001
From: Christopher Albert <albert@tugraz.at>
Date: Tue, 11 Nov 2025 00:34:32 +0100
Subject: [PATCH] fortran: clarify spec-stmt ordering error

* parse.cc (parse_executable): Reject declaration/OpenMP spec statements
  with "in the execution part" diagnostic when seen after executable code.
* testsuite/gfortran.dg/spec_statement_in_exec.f90: New regression.
* testsuite/gfortran.dg/common_22.f90: Expect new COMMON wording.
* testsuite/gfortran.dg/common_24.f: Likewise.
* testsuite/gfortran.dg/pr61669.f90: Likewise for data declarations.
* testsuite/gfortran.dg/goacc/routine-1.f90: Expect new !$ACC message.
* testsuite/gfortran.dg/goacc/routine-2.f90: Likewise.
* testsuite/gfortran.dg/gomp/declare-variant-17.f90: Update message.
* testsuite/gfortran.dg/gomp/interop-1.f90: Likewise.
* testsuite/gfortran.dg/gomp/order-2.f90: Likewise for OpenMP directives.
* testsuite/gfortran.dg/gomp/pr78026.f03: Likewise for DECLARE SIMD.
* testsuite/gfortran.dg/gomp/requires-4.f90: Likewise for REQUIRES.
* testsuite/gfortran.dg/gomp/requires-6.f90: Likewise.

PR fortran/32365

Signed-off-by: Christopher Albert <albert@tugraz.at>
---
 gcc/fortran/parse.cc                          |  9 +++++++
 gcc/testsuite/gfortran.dg/common_22.f90       | 16 +++++------
 gcc/testsuite/gfortran.dg/common_24.f         |  2 +-
 gcc/testsuite/gfortran.dg/goacc/routine-1.f90 |  6 ++---
 gcc/testsuite/gfortran.dg/goacc/routine-2.f90 |  2 +-
 .../gfortran.dg/gomp/declare-variant-17.f90   |  4 +--
 gcc/testsuite/gfortran.dg/gomp/interop-1.f90  |  2 +-
 gcc/testsuite/gfortran.dg/gomp/order-2.f90    | 10 +++----
 gcc/testsuite/gfortran.dg/gomp/pr78026.f03    |  2 +-
 gcc/testsuite/gfortran.dg/gomp/requires-4.f90 |  2 +-
 gcc/testsuite/gfortran.dg/gomp/requires-6.f90 |  2 +-
 gcc/testsuite/gfortran.dg/pr61669.f90         |  4 +--
 .../gfortran.dg/spec_statement_in_exec.f90    | 27 +++++++++++++++++++
 13 files changed, 62 insertions(+), 26 deletions(-)
 create mode 100644 gcc/testsuite/gfortran.dg/spec_statement_in_exec.f90

diff --git a/gcc/fortran/parse.cc b/gcc/fortran/parse.cc
index f987f464023..95e1bc999a7 100644
--- a/gcc/fortran/parse.cc
+++ b/gcc/fortran/parse.cc
@@ -7132,6 +7132,15 @@ loop:
 	  accept_statement (st);
 	  goto done;
 
+	/* Specification statements cannot appear in the execution part.  */
+	case_decl:
+	case_omp_decl:
+	  gfc_error ("%s statement cannot appear in the execution part at %C",
+		     gfc_ascii_statement (st));
+	  reject_statement ();
+	  st = next_statement ();
+	  continue;
+
 	default:
 	  break;
 	}
diff --git a/gcc/testsuite/gfortran.dg/common_22.f90 b/gcc/testsuite/gfortran.dg/common_22.f90
index e2254099d72..74917d679d8 100644
--- a/gcc/testsuite/gfortran.dg/common_22.f90
+++ b/gcc/testsuite/gfortran.dg/common_22.f90
@@ -7,18 +7,18 @@
 ! Contributed by Bud Davis  <jmdavis@link.com>
 
       CALL RCCFL (NVE,IR,NU3,VE (1,1,1,I))
-      COMMON /CCFILE/ INTG,NT1,NT2,NT3,NVM,NVE,NFRLE,NRESF,NRESL !{ dg-error "Unexpected COMMON" }
-      COMMON /CCFILE/ INTG,NT1,NT2,NT3,NVM,NVE,NFRLE,NRESF,NRESL !{ dg-error "Unexpected COMMON" }
+      COMMON /CCFILE/ INTG,NT1,NT2,NT3,NVM,NVE,NFRLE,NRESF,NRESL !{ dg-error "COMMON statement cannot appear in the execution part" }
+      COMMON /CCFILE/ INTG,NT1,NT2,NT3,NVM,NVE,NFRLE,NRESF,NRESL !{ dg-error "COMMON statement cannot appear in the execution part" }
 !  the PR only contained the two above.
 !  success is no segfaults or infinite loops.
 !  let's check some combinations
      CALL ABC (INTG)
-     COMMON /CCFILE/ INTG,NT1,NT2,NT3,NVM,NVE,NFRLE,NRESF,NRESL !{ dg-error "Unexpected COMMON" }
-     COMMON /CCFILE/ INTG,NT1,NT2,NT3,NVM,NVE,NFRLE,NRESF,NRESL !{ dg-error "Unexpected COMMON" }
+     COMMON /CCFILE/ INTG,NT1,NT2,NT3,NVM,NVE,NFRLE,NRESF,NRESL !{ dg-error "COMMON statement cannot appear in the execution part" }
+     COMMON /CCFILE/ INTG,NT1,NT2,NT3,NVM,NVE,NFRLE,NRESF,NRESL !{ dg-error "COMMON statement cannot appear in the execution part" }
      CALL DEF (NT1)
-     COMMON /CCFILE/ INTG,NT1,NT2,NT3,NVM,NVE,NFRLE,NRESF,NRESL !{ dg-error "Unexpected COMMON" }
-     COMMON /CCFILE/ INTG,NT1,NT2,NT3,NVM,NVE,NFRLE,NRESF,NRESL !{ dg-error "Unexpected COMMON" }
+     COMMON /CCFILE/ INTG,NT1,NT2,NT3,NVM,NVE,NFRLE,NRESF,NRESL !{ dg-error "COMMON statement cannot appear in the execution part" }
+     COMMON /CCFILE/ INTG,NT1,NT2,NT3,NVM,NVE,NFRLE,NRESF,NRESL !{ dg-error "COMMON statement cannot appear in the execution part" }
      CALL GHI (NRESL)
-     COMMON /CCFILE/ INTG,NT1,NT2,NT3,NVM,NVE,NFRLE,NRESF,NRESL !{ dg-error "Unexpected COMMON" }
-     COMMON /CCFILE/ INTG,NT1,NT2,NT3,NVM,NVE,NFRLE,NRESF,NRESL !{ dg-error "Unexpected COMMON" }
+     COMMON /CCFILE/ INTG,NT1,NT2,NT3,NVM,NVE,NFRLE,NRESF,NRESL !{ dg-error "COMMON statement cannot appear in the execution part" }
+     COMMON /CCFILE/ INTG,NT1,NT2,NT3,NVM,NVE,NFRLE,NRESF,NRESL !{ dg-error "COMMON statement cannot appear in the execution part" }
      END
