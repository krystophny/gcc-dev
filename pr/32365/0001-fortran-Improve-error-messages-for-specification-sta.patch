diff --git a/gcc/testsuite/gfortran.dg/spec_statement_in_exec.f90 b/gcc/testsuite/gfortran.dg/spec_statement_in_exec.f90
new file mode 100644
index 00000000000..3e2ffeca3db
--- /dev/null
+++ b/gcc/testsuite/gfortran.dg/spec_statement_in_exec.f90
@@ -0,0 +1,27 @@
+! { dg-do compile }
+! { dg-options "-fopenmp" }
+! Test improved error messages for specification statements in executable section
+! PR fortran/32365 - Better error message for specification statement in executable section
+
+subroutine test_spec_in_exec
+  implicit none
+  integer :: i
+
+  ! First executable statement
+  i = 1
+
+  ! Test key specification statement types
+  integer :: j                     ! { dg-error "data declaration statement cannot appear in the execution part" }
+  real :: x                       ! { dg-error "data declaration statement cannot appear in the execution part" }
+  complex :: z                    ! { dg-error "data declaration statement cannot appear in the execution part" }
+  logical :: flag                  ! { dg-error "data declaration statement cannot appear in the execution part" }
+  character(len=20) :: name       ! { dg-error "data declaration statement cannot appear in the execution part" }
+  double precision :: d           ! { dg-error "data declaration statement cannot appear in the execution part" }
+  common /myblock/ i              ! { dg-error "COMMON statement cannot appear in the execution part" }
+  equivalence (i, i)              ! { dg-error "EQUIVALENCE statement cannot appear in the execution part" }
+  namelist /nml/ i                ! { dg-error "NAMELIST statement cannot appear in the execution part" }
+  data i / 2 /                    ! { dg-error "DATA statement cannot appear in the execution part" }
+!$omp threadprivate(i)             ! { dg-error "THREADPRIVATE statement cannot appear in the execution part" }
+!$omp declare target (i)           ! { dg-error "DECLARE TARGET statement cannot appear in the execution part" }
+
+end subroutine test_spec_in_exec
