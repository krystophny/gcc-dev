From 2dd03ae06a4c21edd092ccd937cd24b719cc5142 Mon Sep 17 00:00:00 2001
From: Christopher Albert <albert@tugraz.at>
Date: Sun, 29 Mar 2026 13:32:38 +0200
Subject: [PATCH] fortran: Fix factored descriptors for bounds-checked arrays
 [PR124661]

Keep descriptor factoring local to the saved expression so bounds checks do
not rewrite shared trees and end up using temporaries before they are
initialized. This extends the original fix to nested component arrays from the
latest Bugzilla discussion while preserving the original type-bound procedure
case.

	PR fortran/124661

gcc/fortran/ChangeLog:

	* trans-array.cc: Include gimplify.h.
	(set_factored_descriptor_value): Unshare the expression before
	factoring it. Keep a previously saved descriptor reference when
	walking through an INDIRECT_REF.
	(gfc_conv_ss_descriptor): Use the factored descriptor for data and
	offset accesses.

gcc/testsuite/ChangeLog:

	* gfortran.dg/pr124661.f90: New test.

Signed-off-by: Christopher Albert <albert@tugraz.at>
---
 gcc/fortran/trans-array.cc             | 25 ++++++----
 gcc/testsuite/gfortran.dg/pr124661.f90 | 65 ++++++++++++++++++++++++++
 2 files changed, 82 insertions(+), 8 deletions(-)
 create mode 100644 gcc/testsuite/gfortran.dg/pr124661.f90

diff --git a/gcc/fortran/trans-array.cc b/gcc/fortran/trans-array.cc
index a2da4fe7c7d..de623fc0b31 100644
--- a/gcc/fortran/trans-array.cc
+++ b/gcc/fortran/trans-array.cc
@@ -82,6 +82,7 @@ along with GCC; see the file COPYING3.  If not see
 #include "tree.h"
 #include "gfortran.h"
 #include "gimple-expr.h"
+#include "gimplify.h"
 #include "tree-iterator.h"
 #include "stringpool.h"  /* Required by "attribs.h".  */
 #include "attribs.h" /* For lookup_attribute.  */
@@ -3531,6 +3532,8 @@ save_ref (tree &code, tree &ref, vec<tree> &replacement_roots)
 static void
 set_factored_descriptor_value (tree *desc_ptr, tree value, stmtblock_t *block)
 {
+  value = unshare_expr (value);
+
   /* As the reference is processed from outer to inner, variable definitions
      will be generated in reversed order, so can't be put directly in BLOCK.
      We use TMP_BLOCK instead.  */
@@ -3565,6 +3568,8 @@ set_factored_descriptor_value (tree *desc_ptr, tree value, stmtblock_t *block)
 
 	  if (!maybe_reallocatable)
 	    {
+	      bool saved_prior_ref = false;
+
 	      if (saveable_ref != NULL_TREE && saveable_ref != data_ref)
 		{
 		  /* A reference worth saving has been seen, and now the pointer
@@ -3573,13 +3578,17 @@ set_factored_descriptor_value (tree *desc_ptr, tree value, stmtblock_t *block)
 		     it now.  Otherwise drop it as we prefer saving the
 		     pointer.  */
 		  save_ref (accumulated_code, saveable_ref, replacement_roots);
+		  saved_prior_ref = true;
 		}
 
-	      /* Don't evaluate the pointer to a variable yet; do it only if the
-		 variable would be significantly more simple than the reference
-		 it replaces.  That is if the reference contains anything
-		 different from NOPs, COMPONENTs and DECLs.  */
-	      saveable_ref = next_ref;
+	      if (!saved_prior_ref)
+		{
+		  /* Don't evaluate the pointer to a variable yet; do it only
+		     if the variable would be significantly more simple than the
+		     reference it replaces.  That is if the reference contains
+		     anything different from NOPs, COMPONENTs and DECLs.  */
+		  saveable_ref = next_ref;
+		}
 	    }
 	}
       else if (TREE_CODE (data_ref) == COMPONENT_REF)
@@ -3657,16 +3666,16 @@ gfc_conv_ss_descriptor (stmtblock_t * block, gfc_ss * ss, int base)
 						TYPE_NAME (arraytype)));
 	}
       /* Also the data pointer.  */
-      tmp = gfc_conv_array_data (se.expr);
+      tmp = gfc_conv_array_data (info->descriptor);
       /* If this is a variable or address or a class array, use it directly.
          Otherwise we must evaluate it now to avoid breaking dependency
 	 analysis by pulling the expressions for elemental array indices
 	 inside the loop.  */
-      if (save_descriptor_data (se.expr, tmp) && !ss->is_alloc_lhs)
+      if (save_descriptor_data (info->descriptor, tmp) && !ss->is_alloc_lhs)
 	tmp = gfc_evaluate_now (tmp, block);
       info->data = tmp;
 
-      tmp = gfc_conv_array_offset (se.expr);
+      tmp = gfc_conv_array_offset (info->descriptor);
       if (!ss->is_alloc_lhs)
 	tmp = gfc_evaluate_now (tmp, block);
       info->offset = tmp;
diff --git a/gcc/testsuite/gfortran.dg/pr124661.f90 b/gcc/testsuite/gfortran.dg/pr124661.f90
new file mode 100644
index 00000000000..106a0ecf10b
--- /dev/null
+++ b/gcc/testsuite/gfortran.dg/pr124661.f90
@@ -0,0 +1,65 @@
+! { dg-do run }
+! { dg-options "-fcheck=bounds" }
+!
+! PR fortran/124661
+
+module m
+  implicit none
+
+  type point_t
+    real :: coords(1:3)
+  end type point_t
+
+  type intermediary_t
+    type(point_t), allocatable :: ac(:)
+  end type intermediary_t
+
+  type point_cloud_t
+    type(point_t), allocatable :: points(:)
+  contains
+    procedure :: init_point_cloud
+  end type point_cloud_t
+
+  type nested_point_cloud_t
+    type(intermediary_t), allocatable :: points(:)
+  contains
+    procedure :: init_nested_point_cloud
+  end type nested_point_cloud_t
+
+contains
+
+  subroutine init_point_cloud (c)
+    class(point_cloud_t) :: c
+    real :: expected(3)
+
+    expected = [1.0, 2.0, 3.0]
+    allocate (c%points(1))
+    c%points(1)%coords = expected
+
+    if (c%points(1)%coords(3) /= expected(3)) stop 1
+    if (any (c%points(1)%coords /= expected)) stop 2
+  end subroutine init_point_cloud
+
+  subroutine init_nested_point_cloud (c)
+    class(nested_point_cloud_t) :: c
+    real :: expected(3)
+
+    expected = [4.0, 5.0, 6.0]
+    allocate (c%points(1))
+    allocate (c%points(1)%ac(1))
+    c%points(1)%ac(1)%coords = expected
+
+    if (c%points(1)%ac(1)%coords(3) /= expected(3)) stop 3
+    if (any (c%points(1)%ac(1)%coords /= expected)) stop 4
+  end subroutine init_nested_point_cloud
+end module m
+
+program p
+  use m, only: nested_point_cloud_t, point_cloud_t
+  implicit none
+  type(point_cloud_t) :: c
+  type(nested_point_cloud_t) :: nested
+
+  call c%init_point_cloud
+  call nested%init_nested_point_cloud
+end program p
-- 
2.53.0

