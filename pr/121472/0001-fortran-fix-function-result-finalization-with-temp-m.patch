From 920adcf4a0be1d50919c1849410d944cb8a5fe5f Mon Sep 17 00:00:00 2001
From: Christopher Albert <albert@tugraz.at>
Date: Thu, 20 Nov 2025 16:46:46 +0100
Subject: [PATCH] fortran: fix function result finalization with temp metadata
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Track temp metadata (typespec, rank, finalizable) and use it at temp
teardown to finalize function results exactly once, achieving ISO/IEC
1539-1:2018 Section 7.5.6.3 compliance.

This fixes over-finalization in finalize_55.f90 where elemental function
results were finalized multiple times (counter=12) instead of once per
result (counter=6→16 expected).

Also guard default allocatable deep copy to skip self-descriptors used
in assignment helpers, preventing ICE in self-referencing cases.

	PR fortran/121472

gcc/fortran/ChangeLog:

	* trans.h (gfc_ss_info): Add temp_ts, temp_rank, temp_finalizable
	fields for tracking temporary metadata.
	* trans-array.h (gfc_get_temp_ss): Add typespec argument to pass
	type information for finalization.
	* trans-array.cc (gfc_get_temp_ss): Store temp metadata including
	typespec, rank, and finalizable flag. Initialize fields to safe
	defaults when typespec is NULL.
	(gfc_trans_create_temp_array): Implement finalization consumer
	that checks temp_finalizable flag and calls finalization for temp
	arrays before deallocation, ensuring exactly one finalization per
	function result temporary.
	(structure_alloc_comps): Require distinct component refs (dest,
	COMPONENT_REF checks) and distinct base decls (decl != dest) before
	recursive deep copy to avoid self-referencing during assignment
	helper generation.
	(gfc_conv_resolve_dependencies, gfc_conv_expr_descriptor): Update
	gfc_get_temp_ss calls to pass typespec.
	* trans-expr.cc (gfc_conv_subref_array_arg): Update gfc_get_temp_ss
	call to pass typespec.
	(gfc_trans_assignment_1): Simplify RHS finalization logic. With
	temp metadata tracking and finalization at temp teardown, remove
	conditional suppression based on l_is_temp and elemental function
	checks.

gcc/testsuite/ChangeLog:

	* gfortran.dg/finalize_55.f90: Now passes with correct finalization
	count (ctr=6 at stop 2, ctr=16 at stop 4).

Signed-off-by: Christopher Albert <albert@tugraz.at>
---
 gcc/fortran/trans-array.cc | 80 ++++++++++++++++++++++++++++++++++----
 gcc/fortran/trans-array.h  |  2 +-
 gcc/fortran/trans-expr.cc  | 14 ++++---
 gcc/fortran/trans.h        |  3 ++
 4 files changed, 85 insertions(+), 14 deletions(-)

diff --git a/gcc/fortran/trans-array.cc b/gcc/fortran/trans-array.cc
index cd137212260..003a5ad2a25 100644
--- a/gcc/fortran/trans-array.cc
+++ b/gcc/fortran/trans-array.cc
@@ -728,7 +728,8 @@ gfc_get_array_ss (gfc_ss *next, gfc_expr *expr, int dimen, gfc_ss_type type)
 /* Creates and initializes a temporary type gfc_ss struct.  */
 
 gfc_ss *
-gfc_get_temp_ss (tree type, tree string_length, int dimen)
+gfc_get_temp_ss (tree type, tree string_length, int dimen,
+		 const gfc_typespec *ts)
 {
   gfc_ss *ss;
   gfc_ss_info *ss_info;
@@ -739,6 +740,22 @@ gfc_get_temp_ss (tree type, tree string_length, int dimen)
   ss_info->type = GFC_SS_TEMP;
   ss_info->string_length = string_length;
   ss_info->data.temp.type = type;
+  if (ts)
+    {
+      ss_info->temp_ts = *ts;
+      ss_info->temp_rank = dimen;
+      ss_info->temp_finalizable = gfc_may_be_finalized (*ts)
+				  || ((ts->type == BT_CLASS
+				       || ts->type == BT_DERIVED)
+				      && ts->u.derived
+				      && ts->u.derived->attr.alloc_comp);
+    }
+  else
+    {
+      memset (&ss_info->temp_ts, 0, sizeof (gfc_typespec));
+      ss_info->temp_rank = 0;
+      ss_info->temp_finalizable = false;
+    }
 
   ss = gfc_get_ss ();
   ss->info = ss_info;
@@ -1797,6 +1814,44 @@ gfc_trans_create_temp_array (stmtblock_t * pre, stmtblock_t * post, gfc_ss * ss,
   gfc_trans_allocate_array_storage (pre, post, info, size, nelem, initial,
 				    dynamic, dealloc);
 
+  /* Finalize temp arrays before deallocation if needed.
+     Check temp_finalizable flag set during temp creation to determine
+     if this temp holds finalizable function results.  Finalization must
+     occur before memory is freed (in post block).  */
+  if (dealloc && ss->info->type == GFC_SS_TEMP && ss->info->temp_finalizable
+      && ss->info->temp_ts.type == BT_DERIVED
+      && ss->info->temp_ts.u.derived != NULL)
+    {
+      stmtblock_t fin_block;
+      gfc_se fse;
+      symbol_attribute attr;
+
+      gfc_init_block (&fin_block);
+      gfc_init_se (&fse, NULL);
+      fse.expr = desc;
+
+      /* Create attribute for finalization call.  */
+      gfc_clear_attr (&attr);
+      attr.dimension = 1;
+      attr.pointer = 0;
+      attr.allocatable = 0;
+
+      /* Call finalization for the temp array.  This finalizes each element
+	 once before the temp is deallocated, achieving ISO F2018 7.5.6.3
+	 compliance for function result temporaries.  */
+      gfc_finalize_tree_expr (&fse, ss->info->temp_ts.u.derived, attr,
+			      ss->info->temp_rank);
+
+      /* Add finalization before deallocation in post block.  */
+      gfc_add_block_to_block (&fin_block, &fse.pre);
+      gfc_add_block_to_block (&fin_block, &fse.finalblock);
+      gfc_add_block_to_block (&fin_block, &fse.post);
+
+      /* Prepend finalization so it occurs before gfc_call_free in post.  */
+      if (fin_block.head != NULL_TREE)
+	gfc_prepend_expr_to_block (post, fin_block.head);
+    }
+
   while (ss->parent)
     ss = ss->parent;
 
@@ -5827,8 +5882,9 @@ temporary:
       if (GFC_ARRAY_TYPE_P (base_type)
 	  || GFC_DESCRIPTOR_TYPE_P (base_type))
 	base_type = gfc_get_element_type (base_type);
-      loop->temp_ss = gfc_get_temp_ss (base_type, dest->info->string_length,
-				       loop->dimen);
+      loop->temp_ss
+	= gfc_get_temp_ss (base_type, dest->info->string_length,
+			   loop->dimen, &dest_expr->ts);
       gfc_add_ss_to_loop (loop, loop->temp_ss);
     }
   else
@@ -8590,7 +8646,7 @@ gfc_conv_expr_descriptor (gfc_se *se, gfc_expr *expr)
 				      ((expr->ts.type == BT_CHARACTER)
 				       ? expr->ts.u.cl->backend_decl
 				       : NULL),
-				      loop.dimen);
+				      loop.dimen, &expr->ts);
 
       se->string_length = loop.temp_ss->info->string_length;
       gcc_assert (loop.temp_ss->dimen == loop.dimen);
@@ -11003,10 +11059,18 @@ structure_alloc_comps (gfc_symbol * der_type, tree decl, tree dest,
       /* Special case: recursive allocatable array components require
 	 runtime helpers to avoid compile-time infinite recursion.  Generate
 	 a call to _gfortran_cfi_deep_copy_array with an element copy
-	 wrapper.  When inside a wrapper, reuse current_function_decl.  */
-      else if (c->attr.allocatable && c->as && cmp_has_alloc_comps && same_type
-	       && purpose == COPY_ALLOC_COMP && !c->attr.proc_pointer
-	       && !c->attr.codimension && !caf_in_coarray (caf_mode)
+	 wrapper.  When inside a wrapper, reuse current_function_decl.
+	 Require distinct component references (dest && COMPONENT_REF checks)
+	 and distinct base decls (decl != dest) to avoid self-referencing
+	 during assignment helper generation.  */
+      else if (dest
+	       && TREE_CODE (dcmp) == COMPONENT_REF
+	       && TREE_CODE (comp) == COMPONENT_REF
+	       && decl != dest
+	       && c->attr.allocatable && c->as && cmp_has_alloc_comps
+	       && same_type && purpose == COPY_ALLOC_COMP
+	       && !c->attr.proc_pointer && !c->attr.codimension
+	       && !caf_in_coarray (caf_mode)
 	       && c->ts.type == BT_DERIVED && c->ts.u.derived != NULL)
 	    {
 	      tree copy_wrapper, call, dest_addr, src_addr, elem_type;
diff --git a/gcc/fortran/trans-array.h b/gcc/fortran/trans-array.h
index 345a9752ddd..c3cf298f466 100644
--- a/gcc/fortran/trans-array.h
+++ b/gcc/fortran/trans-array.h
@@ -113,7 +113,7 @@ void gfc_free_ss (gfc_ss *);
 /* Allocate a new array type ss.  */
 gfc_ss *gfc_get_array_ss (gfc_ss *, gfc_expr *, int, gfc_ss_type);
 /* Allocate a new temporary type ss.  */
-gfc_ss *gfc_get_temp_ss (tree, tree, int);
+gfc_ss *gfc_get_temp_ss (tree, tree, int, const gfc_typespec *);
 /* Allocate a new scalar type ss.  */
 gfc_ss *gfc_get_scalar_ss (gfc_ss *, gfc_expr *);
 
diff --git a/gcc/fortran/trans-expr.cc b/gcc/fortran/trans-expr.cc
index ac85b762c7f..1ec0de30107 100644
--- a/gcc/fortran/trans-expr.cc
+++ b/gcc/fortran/trans-expr.cc
@@ -5519,7 +5519,7 @@ gfc_conv_subref_array_arg (gfc_se *se, gfc_expr * expr, int g77,
   loop.temp_ss = gfc_get_temp_ss (base_type, ((expr->ts.type == BT_CHARACTER)
 					      ? expr->ts.u.cl->backend_decl
 					      : NULL),
-				  loop.dimen);
+				  loop.dimen, &expr->ts);
 
   parmse->string_length = loop.temp_ss->info->string_length;
 
@@ -13470,10 +13470,14 @@ gfc_trans_assignment_1 (gfc_expr * expr1, gfc_expr * expr2, bool init_flag,
   gfc_add_expr_to_block (&body, tmp);
 
   /* Add the post blocks to the body.  Scalar finalization must appear before
-     the post block in case any dellocations are done.  */
-  if (rse.finalblock.head
-      && (!l_is_temp || (expr2->expr_type == EXPR_FUNCTION
-			 && gfc_expr_attr (expr2).elemental)))
+     the post block in case any dellocations are done.
+     NOTE: Previous logic conditionally suppressed finalization based on
+     l_is_temp and elemental function checks.  With temp metadata tracking
+     (temp_finalizable), finalization strategy is now handled at temp
+     teardown, so we finalize RHS whenever finalblock is present.  */
+  bool rhs_finalize_now = rse.finalblock.head;
+
+  if (rhs_finalize_now)
     {
       gfc_add_block_to_block (&body, &rse.finalblock);
       gfc_add_block_to_block (&body, &rse.post);
diff --git a/gcc/fortran/trans.h b/gcc/fortran/trans.h
index 6a465f480dd..dfb257d3539 100644
--- a/gcc/fortran/trans.h
+++ b/gcc/fortran/trans.h
@@ -264,6 +264,9 @@ typedef struct gfc_ss_info
   gfc_expr *expr;
   tree string_length;
   tree class_container;
+  gfc_typespec temp_ts;
+  int temp_rank;
+  bool temp_finalizable;
 
   union
   {
-- 
2.52.0

