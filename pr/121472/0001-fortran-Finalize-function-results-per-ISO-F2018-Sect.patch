From 6b4c273fd5dcb7484ec3166a84fd2dd33c97efc8 Mon Sep 17 00:00:00 2001
From: Christopher Albert <albert@tugraz.at>
Date: Fri, 14 Nov 2025 22:33:01 +0100
Subject: [PATCH] fortran: Finalize function results per ISO F2018 Section
 7.5.6.3

ISO/IEC 1539-1:2018 Section 7.5.6.3 paragraph 3 requires finalization
of function results after intrinsic assignment. This patch implements
function result finalization for derived types with finalizers.

This also fixes an ICE in gimplify_expr when using derived types with
both finalizers and constructor interfaces, as the finalization code
was attempting to finalize unevaluated CALL_EXPR nodes.

	PR fortran/121472

gcc/fortran/ChangeLog:

	* trans.cc (gfc_finalize_tree_expr): Skip finalization for
	unevaluated CALL_EXPR when type lacks allocatable components.
	* trans-expr.cc (gfc_conv_procedure_call): Add finalization
	of function results with finalizable derived type per F2018.

gcc/testsuite/ChangeLog:

	* gfortran.dg/finalize_constructor_1.f90: Update test to expect
	ISO-compliant finalization behavior.
	* gfortran.dg/finalize_45.f90: Update comment to reference
	Fortran 2018 standard.

Signed-off-by: Christopher Albert <albert@tugraz.at>
---
 gcc/fortran/trans-expr.cc                     | 23 +++++++++++++++--
 gcc/fortran/trans.cc                          | 20 +++++++++------
 gcc/testsuite/gfortran.dg/finalize_45.f90     |  4 +--
 .../gfortran.dg/finalize_constructor_1.f90    | 25 ++++++++++++-------
 4 files changed, 50 insertions(+), 22 deletions(-)

diff --git a/gcc/fortran/trans-expr.cc b/gcc/fortran/trans-expr.cc
index ac85b762c7f..81656f7290f 100644
--- a/gcc/fortran/trans-expr.cc
+++ b/gcc/fortran/trans-expr.cc
@@ -8803,7 +8803,8 @@ gfc_conv_procedure_call (gfc_se * se, gfc_symbol * sym,
   bool finalizable = der != NULL && der->ns->proc_name
 			    && gfc_is_finalizable (der, NULL);
 
-  if (!byref && finalizable)
+  if (!byref && finalizable
+      && !(expr && expr->must_finalize))
     gfc_finalize_tree_expr (se, der, attr, expr->rank);
 
   if (!byref && sym->ts.type != BT_CHARACTER
@@ -8870,7 +8871,8 @@ gfc_conv_procedure_call (gfc_se * se, gfc_symbol * sym,
 	      /* Bundle in the string length.  */
 	      se->string_length = len;
 
-	      if (finalizable)
+	      if (finalizable
+		  && !(expr && expr->must_finalize))
 		gfc_finalize_tree_expr (se, der, attr, expr->rank);
 	    }
 	  else if (ts.type == BT_CHARACTER)
@@ -8977,6 +8979,23 @@ gfc_conv_procedure_call (gfc_se * se, gfc_symbol * sym,
 		&& attr.pointer))
 	    gfc_finalize_tree_expr (se, NULL, attr, expr->rank);
 	}
+      /* For a function with a finalizable derived type result,
+	 finalize the result after assignment per ISO/IEC 1539-1:2018
+	 Section 7.5.6.3 paragraph 3.  */
+      else if (expr && expr->expr_type == EXPR_FUNCTION
+	       && expr->ts.type == BT_DERIVED
+	       && expr->must_finalize
+	       && gfc_is_finalizable (expr->ts.u.derived, NULL))
+	{
+	  se->expr = gfc_evaluate_now (se->expr, &se->pre);
+
+	  /* Finalize the result, if necessary.  */
+	  attr = expr->value.function.esym
+		 ? expr->value.function.esym->result->attr
+		 : expr->symtree->n.sym->attr;
+	  if (!attr.pointer)
+	    gfc_finalize_tree_expr (se, expr->ts.u.derived, attr, expr->rank);
+	}
       gfc_add_block_to_block (&se->post, &post);
     }
 
diff --git a/gcc/fortran/trans.cc b/gcc/fortran/trans.cc
index 4bce4aee062..fd308448416 100644
--- a/gcc/fortran/trans.cc
+++ b/gcc/fortran/trans.cc
@@ -1653,15 +1653,19 @@ gfc_finalize_tree_expr (gfc_se *se, gfc_symbol *derived,
   if (attr.pointer)
     return;
 
-  /* Skip finalization for unevaluated function/constructor call results.
-     When se->expr is a CALL_EXPR at this point, it represents a constructor
-     or function result being assigned. These results are already properly
-     initialized and will be finalized via the assignment path if needed.
-     Attempting to finalize them here causes ICEs during gimplification when
-     the type has non-allocatable components but is marked with alloc_comp
-     due to transitive attribute inheritance from nested derived types.
+  /* Skip finalization for unevaluated function/constructor call results when
+     the type doesn't actually need deep copy despite having alloc_comp set.
+
+     When se->expr is a CALL_EXPR at this point, it represents an unevaluated
+     constructor or function result. For types with transitive alloc_comp but
+     no actual allocatable components, attempting to finalize causes ICEs during
+     gimplification.
+
+     Types with actual allocatable components need finalization even for
+     CALL_EXPR to handle cases like: obj = func_returning_allocatable_type()
      PR121472  */
-  if (se->expr && TREE_CODE (se->expr) == CALL_EXPR)
+  if (se->expr && TREE_CODE (se->expr) == CALL_EXPR
+      && derived && !gfc_derived_needs_copy (derived))
     return;
 
   /* Derived type function results with components that have defined
diff --git a/gcc/testsuite/gfortran.dg/finalize_45.f90 b/gcc/testsuite/gfortran.dg/finalize_45.f90
index 0819cf6e168..79b5c66e88d 100644
--- a/gcc/testsuite/gfortran.dg/finalize_45.f90
+++ b/gcc/testsuite/gfortran.dg/finalize_45.f90
@@ -122,9 +122,7 @@ contains
 
    call foo%clean()
 
-! NAGFOR has assoc_counts =2, which is probably correct. If nullification
-! of the pointer component is not done in gfortran, function finalization
-! results in a double free. TODO fix this.
+! Function result finalization per Fortran 2018 Section 7.5.6.3.
    if (final_counts /= 2) stop 3
    if (assoc_counts /= 2) stop 4
    end
diff --git a/gcc/testsuite/gfortran.dg/finalize_constructor_1.f90 b/gcc/testsuite/gfortran.dg/finalize_constructor_1.f90
index 052fa2fd552..ea95d0707a2 100644
--- a/gcc/testsuite/gfortran.dg/finalize_constructor_1.f90
+++ b/gcc/testsuite/gfortran.dg/finalize_constructor_1.f90
@@ -1,16 +1,23 @@
 ! { dg-do run }
-! { dg-output "constructor: *1(\n|\r\n|\r)" }
-! { dg-output "finalizer: *(1|2)(\n|\r\n|\r)" }
+! { dg-output " constructor: *1(\n|\r\n|\r)" }
+! { dg-output " finalizer: *2(\n|\r\n|\r)" }
 ! PR fortran/121472
 ! Test that derived types with finalizers and constructor interfaces compile
-! without ICE when assigned from constructor calls.
+! without ICE and produce ISO F2018 compliant finalization behavior.
 !
-! Per Fortran 2018 standard, function results (including function constructors)
-! should be finalized after assignment. Full standard-compliant behavior:
-!   - 1 constructor call (creates function result)
-!   - 2 finalizer calls (function result after assignment, obj at scope exit)
-! Current gfortran only finalizes obj (1 call), which is incomplete but acceptable
-! as an implementation limitation. Test accepts both 1 or 2 finalizer calls.
+! ISO/IEC 1539-1:2018 Section 7.5.6.3 paragraph 3:
+! "Finalization occurs ... (3) when an intrinsic assignment statement is
+! executed and ... the variable is of a finalizable type, the variable is
+! finalized after evaluation of expr and before the definition of the variable."
+!
+! For the statement: obj = container_t()
+!
+! Expected finalization count: 2
+!   (1) Function result from container_t() after assignment per 7.5.6.3(3)
+!   (2) Variable obj at end of scope per 7.5.6.3(1)
+!
+! Expected constructor count: 1
+!   (1) Call to container_constructor via container_t()
 !
 ! This used to trigger an internal compiler error in gimplify_expr because
 ! finalization was attempted on unevaluated CALL_EXPR nodes for types with
-- 
2.51.2

