+      /* For RHS function actuals marked for deferred finalization (e.g. in
+         user-defined assignments), finalize after the call returns per
+         ISO/IEC 1539-1:2018 7.5.6.3.  */
+      else if (expr && expr->expr_type == EXPR_FUNCTION
+               && expr->ts.type == BT_DERIVED
+               && expr->must_finalize
+               && gfc_is_finalizable (expr->ts.u.derived, NULL))
+        {
+          se->expr = gfc_evaluate_now (se->expr, &se->pre);
