+          if (fsym && (fsym->ts.type == BT_DERIVED
+                       || fsym->ts.type == BT_ASSUMED)
+              && e->ts.type == BT_CLASS
+              && !CLASS_DATA (e)->attr.dimension
+              && !CLASS_DATA (e)->attr.codimension)
