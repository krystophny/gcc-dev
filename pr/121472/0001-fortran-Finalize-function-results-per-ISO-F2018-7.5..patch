 gcc/fortran/trans-expr.cc                     | 140 ++++++++++++------
 gcc/fortran/trans.cc                          |  54 ++++++-
 gcc/testsuite/gfortran.dg/finalize_45.f90     |   4 +-
 .../gfortran.dg/finalize_constructor_1.f90    |  73 +++++++++
 5 files changed, 227 insertions(+), 52 deletions(-)
 create mode 100644 gcc/testsuite/gfortran.dg/finalize_constructor_1.f90

diff --git a/gcc/fortran/resolve.cc b/gcc/fortran/resolve.cc
index b1d2ff220bf..44463b2cb3b 100644
--- a/gcc/fortran/resolve.cc
+++ b/gcc/fortran/resolve.cc
@@ -12907,6 +12907,7 @@ resolve_ordinary_assign (gfc_code *code, gfc_namespace *ns)
   if (gfc_extend_assign (code, ns))
     {
       gfc_expr** rhsptr;
+      gfc_expr* rhs;
 
       if (code->op == EXEC_ASSIGN_CALL)
 	{
@@ -12936,6 +12937,13 @@ resolve_ordinary_assign (gfc_code *code, gfc_namespace *ns)
 	    && (lhs->symtree->n.sym == (*rhsptr)->symtree->n.sym))
 	*rhsptr = gfc_get_parentheses (*rhsptr);
 
+      /* For user-defined assignment, if RHS is a function returning a
+	 finalizable type, mark it for finalization per F2018 7.5.6.3.  */
+      rhs = *rhsptr;
+      if (rhs && rhs->expr_type == EXPR_FUNCTION
+	  && gfc_may_be_finalized (rhs->ts))
+	rhs->must_finalize = 1;
+
       return true;
     }
 
