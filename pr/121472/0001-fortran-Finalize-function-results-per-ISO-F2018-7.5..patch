From 663b3cf91a33f25cbaf54c0cf64d9505d11ca0ce Mon Sep 17 00:00:00 2001
From: Christopher Albert <albert@tugraz.at>
Date: Tue, 2 Dec 2025 21:19:47 +0100
Subject: [PATCH] fortran: Finalize function results per ISO F2018 7.5.6.3

PR fortran/121472: finalize function results and RHS temporaries per ISO/IEC 1539-1:2018 7.5.6.3, avoid constructor-+finalizer ICE for non-allocatable types, and add regression tests for constructor interfaces and nested elemental calls.

Signed-off-by: Christopher Albert <albert@tugraz.at>
---
 gcc/fortran/resolve.cc                        |  26 +++
 gcc/fortran/trans-array.cc                    |  40 +++++
 gcc/fortran/trans-expr.cc                     | 150 ++++++++++++------
 gcc/fortran/trans.cc                          |  54 ++++++-
 gcc/testsuite/gfortran.dg/finalize_45.f90     |   4 +-
 .../gfortran.dg/finalize_constructor_1.f90    |  73 +++++++++
 pr/121472/docs/FINAL_SOLUTION.md              |  79 +++++++++
 pr/121472/docs/INVESTIGATION_SUMMARY.md       |  71 +++++++++
 8 files changed, 442 insertions(+), 55 deletions(-)
 create mode 100644 gcc/testsuite/gfortran.dg/finalize_constructor_1.f90
 create mode 100644 pr/121472/docs/FINAL_SOLUTION.md
 create mode 100644 pr/121472/docs/INVESTIGATION_SUMMARY.md

diff --git a/gcc/fortran/resolve.cc b/gcc/fortran/resolve.cc
index 2390858424e..24ffe3c1a74 100644
--- a/gcc/fortran/resolve.cc
+++ b/gcc/fortran/resolve.cc
@@ -12911,6 +12911,7 @@ resolve_ordinary_assign (gfc_code *code, gfc_namespace *ns)
   if (gfc_extend_assign (code, ns))
     {
       gfc_expr** rhsptr;
+      gfc_expr* rhs;
 
       if (code->op == EXEC_ASSIGN_CALL)
 	{
@@ -12940,6 +12941,31 @@ resolve_ordinary_assign (gfc_code *code, gfc_namespace *ns)
 	    && (lhs->symtree->n.sym == (*rhsptr)->symtree->n.sym))
 	*rhsptr = gfc_get_parentheses (*rhsptr);
 
+      /* For user-defined assignment, if RHS is a function returning a
+	 finalizable non-allocatable, non-pointer derived-type result, mark it
+	 for finalization per F2018 7.5.6.3.  Allocatable or pointer function
+	 results handle their own finalization semantics and must not be
+	 finalized here to avoid double finalization. */
+      if (*rhsptr && (*rhsptr)->expr_type == EXPR_FUNCTION
+	  && gfc_may_be_finalized ((*rhsptr)->ts)
+	  && (*rhsptr)->symtree->n.sym->result)
+	{
+	  bool allocatable_or_pointer = false;
+
+	  if ((*rhsptr)->symtree->n.sym->result->ts.type == BT_CLASS
+	      && CLASS_DATA ((*rhsptr)->symtree->n.sym->result))
+	    allocatable_or_pointer
+	      = (CLASS_DATA ((*rhsptr)->symtree->n.sym->result)->attr.allocatable
+		 || CLASS_DATA ((*rhsptr)->symtree->n.sym->result)->attr.pointer);
+	  else
+	    allocatable_or_pointer
+	      = ((*rhsptr)->symtree->n.sym->result->attr.allocatable
+		 || (*rhsptr)->symtree->n.sym->result->attr.pointer);
+
+	  if (!allocatable_or_pointer)
+	    (*rhsptr)->must_finalize = 1;
+	}
+
       return true;
     }
 
diff --git a/gcc/fortran/trans-array.cc b/gcc/fortran/trans-array.cc
index cd137212260..456e3c1114c 100644
--- a/gcc/fortran/trans-array.cc
+++ b/gcc/fortran/trans-array.cc
@@ -1797,6 +1797,46 @@ gfc_trans_create_temp_array (stmtblock_t * pre, stmtblock_t * post, gfc_ss * ss,
   gfc_trans_allocate_array_storage (pre, post, info, size, nelem, initial,
 				    dynamic, dealloc);
 
+  /* Finalize temporary arrays created for function results (GFC_SS_FUNCTION).
+     These hold the return values of array-valued or elemental functions and
+     must be finalized after use per F2018 7.5.6.3.  GFC_SS_TEMP (dependency-
+     breaking temps) are not finalized here.  */
+  if (dealloc && ss->info && ss->info->type == GFC_SS_FUNCTION
+      && ss->info->expr
+      && (ss->info->expr->ts.type == BT_DERIVED
+	  || ss->info->expr->ts.type == BT_CLASS)
+      && gfc_may_be_finalized (ss->info->expr->ts))
+    {
+      gfc_se fin_se;
+      stmtblock_t fin_block;
+      symbol_attribute attr;
+      gfc_symbol *derived = NULL;
+
+      gfc_init_block (&fin_block);
+      gfc_init_se (&fin_se, NULL);
+      fin_se.expr = desc;
+
+      attr = gfc_expr_attr (ss->info->expr);
+      attr.pointer = 0;
+      attr.allocatable = 0;
+
+      if (ss->info->expr->ts.type == BT_DERIVED)
+	derived = ss->info->expr->ts.u.derived;
+      else if (ss->info->expr->ts.type == BT_CLASS)
+	derived = CLASS_DATA (ss->info->expr)->ts.u.derived;
+
+      if (derived)
+	{
+	  gfc_finalize_tree_expr (&fin_se, derived, attr, ss->dimen);
+	  gfc_add_block_to_block (&fin_block, &fin_se.pre);
+	  gfc_add_block_to_block (&fin_block, &fin_se.finalblock);
+	  gfc_add_block_to_block (&fin_block, &fin_se.post);
+
+	  if (fin_block.head)
+	    gfc_prepend_expr_to_block (post, gfc_finish_block (&fin_block));
+	}
+    }
+
   while (ss->parent)
     ss = ss->parent;
 
