+		   && (add_when_allocated != NULL_TREE || !cmp_has_alloc_comps || !c->as
+		       || c->attr.codimension || caf_in_coarray (caf_mode)))
 	    {
 	      rank = c->as ? c->as->rank : 0;
 	      if (c->attr.codimension)
