From 11ef97a670da3afd8f3d2f54c39f0f1d43df3c69 Mon Sep 17 00:00:00 2001
From: Christopher Albert <albert@tugraz.at>
Date: Fri, 14 Nov 2025 20:15:26 +0100
Subject: [PATCH] fortran: honor array constructor type-spec during folding

Add helpers so array constructors with explicit type-spec convert their
elements before constant folding, even when parentheses or nested
constructors are present. The testsuite addition covers all intrinsic
types (INTEGER, REAL, COMPLEX, LOGICAL, CHARACTER) with comprehensive
tests for nested constructors, parentheses, and implied-do loops.

	PR fortran/107721
	PR fortran/102417

gcc/fortran/ChangeLog:

	* arith.cc: Include intrinsic.h.
	(array_constructor_allows_conversion): New helper to check if
	array constructor type allows element conversion.
	(maybe_convert_constructor_elements): New helper to convert
	array constructor elements to declared type before folding.
	(reduce_unary): Call maybe_convert_constructor_elements.
	(reduce_binary_ac): Likewise.
	(reduce_binary_ca): Likewise.
	(reduce_binary_aa): Likewise.

gcc/testsuite/ChangeLog:

	* gfortran.dg/array_constructor_typespec_1.f90: New comprehensive
	test for array constructor type-spec preservation with all
	intrinsic types, parentheses, nested constructors, and CLASS(*)
	type verification.

Co-authored-by: Harald Anlauf <anlauf@gcc.gnu.org>
Signed-off-by: Christopher Albert <albert@tugraz.at>
---
 gcc/fortran/arith.cc                          | 160 ++++++++++++-
 gcc/fortran/array.cc                          | 168 ++++++++++++--
 .../array_constructor_typespec_1.f90          | 215 ++++++++++++++++++
 3 files changed, 522 insertions(+), 21 deletions(-)
 create mode 100644 gcc/testsuite/gfortran.dg/array_constructor_typespec_1.f90

diff --git a/gcc/fortran/arith.cc b/gcc/fortran/arith.cc
index 82a8b6fb995..3d1ce6f87ed 100644
--- a/gcc/fortran/arith.cc
+++ b/gcc/fortran/arith.cc
@@ -29,11 +29,97 @@ along with GCC; see the file COPYING3.  If not see
 #include "options.h"
 #include "gfortran.h"
 #include "arith.h"
+#include "intrinsic.h"
 #include "target-memory.h"
 #include "constructor.h"
+#include "match.h"
 
 bool gfc_seen_div0;
 
+static bool
+array_constructor_allows_conversion (const gfc_expr *op)
+{
+  if (op == NULL || op->expr_type != EXPR_ARRAY)
+    return false;
+
+  switch (op->ts.type)
+    {
+    case BT_INTEGER:
+    case BT_REAL:
+    case BT_COMPLEX:
+    case BT_LOGICAL:
+    case BT_UNSIGNED:
+      return true;
+
+    /* CHARACTER needs special handling for length which is done
+       elsewhere during resolution, not during constant folding.  */
+    case BT_CHARACTER:
+      return false;
+
+    default:
+      return false;
+    }
+}
+
+static arith
+maybe_convert_constructor_elements (gfc_expr *op)
+{
+  gfc_constructor *c;
+
+  if (!array_constructor_allows_conversion (op))
+    return ARITH_OK;
+
+  if (op->value.constructor == NULL)
+    return ARITH_OK;
+
+  for (c = gfc_constructor_first (op->value.constructor);
+       c; c = gfc_constructor_next (c))
+    {
+      gfc_expr *converted;
+
+      if (c->expr == NULL)
+	continue;
+
+      gfc_simplify_expr (c->expr, 0);
+
+      if (!gfc_is_constant_expr (c->expr))
+	continue;
+
+      /* For CHARACTER, pad/truncate to the type-spec length even if type
+	 and kind match, since length is part of the type.  */
+      if (c->expr->ts.type == BT_CHARACTER
+	  && op->ts.type == BT_CHARACTER
+	  && op->ts.u.cl && op->ts.u.cl->length
+	  && op->ts.u.cl->length->expr_type == EXPR_CONSTANT)
+	{
+	  HOST_WIDE_INT target_len;
+	  if (gfc_extract_hwi (op->ts.u.cl->length, &target_len))
+	    {
+	      if (c->expr->expr_type == EXPR_CONSTANT
+		  && c->expr->value.character.length != target_len)
+		{
+		  gfc_set_constant_character_len (target_len, c->expr, -1);
+		}
+	    }
+	  continue;
+	}
+
+      /* Skip conversion when type and kind already match.  Matching values
+	 are already validated (literals at parse time, computed values by
+	 their operations), so this avoids redundant conversion calls.  */
+      if (c->expr->ts.type == op->ts.type && c->expr->ts.kind == op->ts.kind)
+	continue;
+
+      converted = gfc_convert_constant (c->expr, op->ts.type, op->ts.kind);
+      if (converted == NULL || converted == &gfc_bad_expr)
+	return ARITH_NOT_REDUCED;
+
+      gfc_replace_expr (c->expr, converted);
+    }
+
+  return ARITH_OK;
+}
+
 /* MPFR does not have a direct replacement for mpz_set_f() from GMP.
    It's easily implemented with a few calls though.  */
 
@@ -1474,6 +1560,10 @@ reduce_unary (arith (*eval) (gfc_expr *, gfc_expr **), gfc_expr *op,
   if (op->expr_type != EXPR_ARRAY)
     return ARITH_NOT_REDUCED;
 
+  rc = maybe_convert_constructor_elements (op);
+  if (rc != ARITH_OK)
+    return rc;
+
   rc = ARITH_OK;
   head = gfc_constructor_copy (op->value.constructor);
   for (c = gfc_constructor_first (head); c; c = gfc_constructor_next (c))
@@ -1528,13 +1618,17 @@ reduce_binary_ac (arith (*eval) (gfc_expr *, gfc_expr *, gfc_expr **),
   gfc_expr *r;
   arith rc = ARITH_OK;
 
+  rc = maybe_convert_constructor_elements (op1);
+  if (rc != ARITH_OK)
+    return rc;
+
+  rc = ARITH_OK;
   head = gfc_constructor_copy (op1->value.constructor);
+
   for (c = gfc_constructor_first (head); c; c = gfc_constructor_next (c))
     {
       arith rc_tmp;
 
-      gfc_simplify_expr (c->expr, 0);
-
       if (c->expr->expr_type == EXPR_CONSTANT)
 	rc_tmp = eval (c->expr, op2, &r);
       else if (c->expr->expr_type != EXPR_ARRAY)
@@ -1565,6 +1659,11 @@ reduce_binary_ac (arith (*eval) (gfc_expr *, gfc_expr *, gfc_expr **),
 	  r = gfc_get_array_expr (c->expr->ts.type, c->expr->ts.kind,
 				  &op1->where);
 	  r->shape = gfc_copy_shape (op1->shape, op1->rank);
+	  /* Copy character length from the result elements, not the
+	     original constructor, since operations like concatenation may
+	     change the character length.  */
+	  if (c->expr->ts.type == BT_CHARACTER && c->expr->ts.u.cl)
+	    r->ts.u.cl = c->expr->ts.u.cl;
 	}
       else
 	{
@@ -1572,6 +1671,9 @@ reduce_binary_ac (arith (*eval) (gfc_expr *, gfc_expr *, gfc_expr **),
 	  r = gfc_get_array_expr (op1->ts.type, op1->ts.kind,
 				  &op1->where);
 	  r->shape = gfc_get_shape (op1->rank);
+	  /* Copy character length from the constructor if applicable.  */
+	  if (op1->ts.type == BT_CHARACTER && op1->ts.u.cl)
+	    r->ts.u.cl = op1->ts.u.cl;
 	}
       r->rank = op1->rank;
       r->corank = op1->corank;
@@ -1592,6 +1694,11 @@ reduce_binary_ca (arith (*eval) (gfc_expr *, gfc_expr *, gfc_expr **),
   gfc_expr *r;
   arith rc = ARITH_OK;
 
+  rc = maybe_convert_constructor_elements (op2);
+  if (rc != ARITH_OK)
+    return rc;
+
+  rc = ARITH_OK;
   head = gfc_constructor_copy (op2->value.constructor);
   for (c = gfc_constructor_first (head); c; c = gfc_constructor_next (c))
     {
@@ -1599,6 +1706,30 @@ reduce_binary_ca (arith (*eval) (gfc_expr *, gfc_expr *, gfc_expr **),
 
       gfc_simplify_expr (c->expr, 0);
 
+      /* For character constants in constructors with type-spec, ensure they're
+	 padded/truncated to the specified length before applying operations.  */
+      if (c->expr->ts.type == BT_CHARACTER
+	  && op2->ts.type == BT_CHARACTER
+	  && op2->ts.u.cl && op2->ts.u.cl->length
+	  && op2->ts.u.cl->length->expr_type == EXPR_CONSTANT)
+	{
+	  HOST_WIDE_INT target_len;
+	  if (gfc_extract_hwi (op2->ts.u.cl->length, &target_len))
+	    {
+	      /* Handle both constants and operations that might simplify to constants.  */
+	      if (c->expr->expr_type == EXPR_OP)
+		{
+		  /* Set typespec and try simplifying again.  */
+		  c->expr->ts.u.cl = op2->ts.u.cl;
+		  gfc_simplify_expr (c->expr, 0);
+		}
+	      
+	      if (c->expr->expr_type == EXPR_CONSTANT
+		  && c->expr->value.character.length != target_len)
+		gfc_set_constant_character_len (target_len, c->expr, -1);
+	    }
+	}
+
       if (c->expr->expr_type == EXPR_CONSTANT)
 	rc_tmp = eval (op1, c->expr, &r);
       else if (c->expr->expr_type != EXPR_ARRAY)
@@ -1629,6 +1760,11 @@ reduce_binary_ca (arith (*eval) (gfc_expr *, gfc_expr *, gfc_expr **),
 	  r = gfc_get_array_expr (c->expr->ts.type, c->expr->ts.kind,
 				  &op2->where);
 	  r->shape = gfc_copy_shape (op2->shape, op2->rank);
+	  /* Copy character length from the result elements, not the
+	     original constructor, since operations like concatenation may
+	     change the character length.  */
+	  if (c->expr->ts.type == BT_CHARACTER && c->expr->ts.u.cl)
+	    r->ts.u.cl = c->expr->ts.u.cl;
 	}
       else
 	{
@@ -1636,6 +1772,9 @@ reduce_binary_ca (arith (*eval) (gfc_expr *, gfc_expr *, gfc_expr **),
 	  r = gfc_get_array_expr (op2->ts.type, op2->ts.kind,
 				  &op2->where);
 	  r->shape = gfc_get_shape (op2->rank);
+	  /* Copy character length from the constructor if applicable.  */
+	  if (op2->ts.type == BT_CHARACTER && op2->ts.u.cl)
+	    r->ts.u.cl = op2->ts.u.cl;
 	}
       r->rank = op2->rank;
       r->corank = op2->corank;
@@ -1661,9 +1800,18 @@ reduce_binary_aa (arith (*eval) (gfc_expr *, gfc_expr *, gfc_expr **),
   gfc_expr *r;
   arith rc = ARITH_OK;
 
+  rc = maybe_convert_constructor_elements (op1);
+  if (rc != ARITH_OK)
+    return rc;
+
+  rc = maybe_convert_constructor_elements (op2);
+  if (rc != ARITH_OK)
+    return rc;
+
   if (!gfc_check_conformance (op1, op2, _("elemental binary operation")))
     return ARITH_INCOMMENSURATE;
 
+  rc = ARITH_OK;
   head = gfc_constructor_copy (op1->value.constructor);
   for (c = gfc_constructor_first (head),
        d = gfc_constructor_first (op2->value.constructor);
@@ -1697,11 +1845,19 @@ reduce_binary_aa (arith (*eval) (gfc_expr *, gfc_expr *, gfc_expr **),
 	{
 	  /* Handle zero-sized arrays.  */
 	  r = gfc_get_array_expr (op1->ts.type, op1->ts.kind, &op1->where);
+	  /* Copy character length if applicable.  */
+	  if (op1->ts.type == BT_CHARACTER && op1->ts.u.cl)
+	    r->ts.u.cl = op1->ts.u.cl;
 	}
       else
 	{
 	  r = gfc_get_array_expr (c->expr->ts.type, c->expr->ts.kind,
 				  &op1->where);
+	  /* Copy character length from the result elements, not the
+	     original constructor, since operations like concatenation may
+	     change the character length.  */
+	  if (c->expr->ts.type == BT_CHARACTER && c->expr->ts.u.cl)
+	    r->ts.u.cl = c->expr->ts.u.cl;
 	}
       r->shape = gfc_copy_shape (op1->shape, op1->rank);
       r->rank = op1->rank;
diff --git a/gcc/fortran/array.cc b/gcc/fortran/array.cc
index 57a7b134e4c..0ffc3dde126 100644
--- a/gcc/fortran/array.cc
+++ b/gcc/fortran/array.cc
@@ -1305,6 +1305,108 @@ done:
 }
 
 
+/* Walk a CHARACTER array constructor and apply type-spec length to all
+   elements, including nested array constructors.  */
+
+static match
+walk_array_constructor_character (gfc_typespec *ts, gfc_constructor_base head)
+{
+  gfc_constructor *c;
+  gfc_expr *e;
+  match m;
+  HOST_WIDE_INT target_length = -1;
+
+  gcc_assert (ts->type == BT_CHARACTER);
+
+  /* Extract the target CHARACTER length from the type-spec.  */
+  if (ts->u.cl && ts->u.cl->length
+      && ts->u.cl->length->expr_type == EXPR_CONSTANT)
+    gfc_extract_hwi (ts->u.cl->length, &target_length);
+
+  for (c = gfc_constructor_first (head); c; c = gfc_constructor_next (c))
+    {
+      e = c->expr;
+
+      /* Recursively handle nested array constructors.  */
+      if (e->expr_type == EXPR_ARRAY && !e->ref && e->value.constructor)
+	{
+	  /* Nested constructor inherits type-spec from parent.  */
+	  if (e->ts.type == BT_UNKNOWN || e->ts.type == BT_CHARACTER)
+	    {
+	      e->ts = *ts;
+	      /* Mark that length comes from type-spec to avoid warnings.  */
+	      if (e->ts.u.cl)
+		e->ts.u.cl->length_from_typespec = true;
+	      m = walk_array_constructor_character (ts, e->value.constructor);
+	      if (m == MATCH_ERROR)
+		return m;
+	    }
+	}
+      else if (e->ts.type == BT_CHARACTER && e->expr_type == EXPR_CONSTANT)
+	{
+	  /* Apply CHARACTER length from type-spec to constant element by
+	     actually padding/truncating the constant value.  */
+	  if (target_length != -1)
+	    {
+	      /* Update typespec reference.  */
+	      e->ts.u.cl = ts->u.cl;
+
+	      /* Pad/truncate the constant value.  Use -1 for check_len
+		 to allow length mismatch (since type-spec overrides).  */
+	      gfc_set_constant_character_len (target_length, e, -1);
+	    }
+	}
+      else if (e->ts.type == BT_CHARACTER && e->expr_type == EXPR_OP)
+	{
+	  /* Apply CHARACTER length from type-spec to character operations
+	     (concatenation, parentheses, etc.) that appear in constructors.
+	     Recursively apply to all operands, then simplify to get a
+	     constant, then pad/truncate that constant.  */
+	  if (target_length != -1 && e->ts.u.cl)
+	    {
+	      e->ts.u.cl = ts->u.cl;
+	      
+	      /* Recursively handle operands first.  */
+	      if (e->value.op.op1 && e->value.op.op1->ts.type == BT_CHARACTER)
+		{
+		  e->value.op.op1->ts.u.cl = ts->u.cl;
+		  if (e->value.op.op1->expr_type == EXPR_CONSTANT)
+		    gfc_set_constant_character_len (target_length,
+						    e->value.op.op1, -1);
+		  else if (e->value.op.op1->expr_type == EXPR_OP)
+		    {
+		      /* Recursively handle nested operations.  */
+		      gfc_simplify_expr (e->value.op.op1, 0);
+		    }
+		}
+	      
+	      if (e->value.op.op2 && e->value.op.op2->ts.type == BT_CHARACTER)
+		{
+		  e->value.op.op2->ts.u.cl = ts->u.cl;
+		  if (e->value.op.op2->expr_type == EXPR_CONSTANT)
+		    gfc_set_constant_character_len (target_length,
+						    e->value.op.op2, -1);
+		  else if (e->value.op.op2->expr_type == EXPR_OP)
+		    {
+		      /* Recursively handle nested operations.  */
+		      gfc_simplify_expr (e->value.op.op2, 0);
+		    }
+		}
+	      
+	      /* Simplify the operation to get a constant result.  */
+	      gfc_simplify_expr (e, 0);
+	      
+	      /* Now pad/truncate the resulting constant if needed.  */
+	      if (e->expr_type == EXPR_CONSTANT)
+		gfc_set_constant_character_len (target_length, e, -1);
+	    }
+	}
+    }
+
+  return MATCH_YES;
+}
+
+
 /* Convert components of an array constructor to the type in ts.  */
 
 static match
@@ -1461,13 +1563,19 @@ done:
 	}
 
       /* Walk the constructor, and if possible, do type conversion for
-	 numeric types.  */
+	 numeric types and CHARACTER length propagation.  */
       if (gfc_numeric_ts (&ts))
 	{
 	  m = walk_array_constructor (&ts, head);
 	  if (m == MATCH_ERROR)
 	    return m;
 	}
+      else if (ts.type == BT_CHARACTER)
+	{
+	  m = walk_array_constructor_character (&ts, head);
+	  if (m == MATCH_ERROR)
+	    return m;
+	}
     }
   else
     expr = gfc_get_array_expr (BT_UNKNOWN, 0, &where);
@@ -2367,28 +2475,50 @@ got_charlen:
       if (found_length != -1)
 	for (p = gfc_constructor_first (expr->value.constructor);
 	     p; p = gfc_constructor_next (p))
-	  if (p->expr->expr_type == EXPR_CONSTANT)
-	    {
-	      gfc_expr *cl = NULL;
-	      HOST_WIDE_INT current_length = -1;
-	      bool has_ts;
-
-	      if (p->expr->ts.u.cl && p->expr->ts.u.cl->length)
+	  {
+	    if (p->expr->expr_type == EXPR_CONSTANT)
 	      {
-		cl = p->expr->ts.u.cl->length;
-		gfc_extract_hwi (cl, &current_length);
-	      }
+		gfc_expr *cl = NULL;
+		HOST_WIDE_INT current_length = -1;
+		bool has_ts;
 
-	      /* If gfc_extract_int above set current_length, we implicitly
-		 know the type is BT_INTEGER and it's EXPR_CONSTANT.  */
+		if (p->expr->ts.u.cl && p->expr->ts.u.cl->length)
+		  {
+		    cl = p->expr->ts.u.cl->length;
+		    gfc_extract_hwi (cl, &current_length);
+		  }
 
-	      has_ts = expr->ts.u.cl->length_from_typespec;
+		/* If gfc_extract_int above set current_length, we implicitly
+		   know the type is BT_INTEGER and it's EXPR_CONSTANT.  */
 
-	      if (! cl
-		  || (current_length != -1 && current_length != found_length))
-		gfc_set_constant_character_len (found_length, p->expr,
-						has_ts ? -1 : found_length);
-	    }
+		has_ts = expr->ts.u.cl->length_from_typespec;
+
+		if (! cl
+		    || (current_length != -1 && current_length != found_length))
+		  gfc_set_constant_character_len (found_length, p->expr,
+						  has_ts ? -1 : found_length);
+	      }
+	    else if (p->expr->expr_type == EXPR_OP && p->expr->ts.type == BT_CHARACTER)
+	      {
+		/* Handle character operations (concat, parentheses, etc.).
+		   Update the typespec to match the constructor's type-spec,
+		   then simplify to get the correctly-sized constant.  */
+		if (p->expr->ts.u.cl != expr->ts.u.cl)
+		  {
+		    p->expr->ts.u.cl = expr->ts.u.cl;
+		    gfc_simplify_expr (p->expr, 0);
+		    
+		    /* After simplification, if it's now a constant, apply the
+		       length again to ensure correct padding/truncation.  */
+		    if (p->expr->expr_type == EXPR_CONSTANT)
+		      {
+			bool has_ts = expr->ts.u.cl->length_from_typespec;
+			gfc_set_constant_character_len (found_length, p->expr,
+							has_ts ? -1 : found_length);
+		      }
+		  }
+	      }
+	  }
     }
 
   return true;
diff --git a/gcc/testsuite/gfortran.dg/array_constructor_typespec_1.f90 b/gcc/testsuite/gfortran.dg/array_constructor_typespec_1.f90
new file mode 100644
index 00000000000..d5d84b2d4df
--- /dev/null
+++ b/gcc/testsuite/gfortran.dg/array_constructor_typespec_1.f90
@@ -0,0 +1,215 @@
+! { dg-do run }
+! PR fortran/107721 - array constructor type-spec lost with parentheses
+! PR fortran/102417 - character array constructor type-spec lost
+!
+! Tests type-spec preservation in array constructors with parentheses,
+! nested constructors, and CLASS(*) type verification for all intrinsic types.
+
+program array_constructor_typespec_1
+    implicit none
+    integer :: i, iscalar
+    integer, dimension(2) :: iarr
+    real, dimension(2) :: rarr
+    real :: rscalar
+    complex, dimension(2) :: carr
+    complex :: cscalar
+    logical, dimension(2) :: larr
+    character(4), dimension(3) :: charr
+    character(8), dimension(2) :: charr8
+    character(16), dimension(3) :: charr16
+    character(16), dimension(2) :: charr16_2
+    character(17), dimension(2) :: charr17
+    character :: x = 'a', y = 'b'
+    class(*), allocatable :: res(:)
+
+    ! INTEGER - runtime value checks
+    iarr = [integer :: [1.0], [2.0]]
+    if (any(iarr /= [1, 2])) stop 1
+    iarr = [integer :: ([1.0]), ([2.0])]
+    if (any(iarr /= [1, 2])) stop 2
+    iarr = [integer :: ((([1.0]))), [2.0]]
+    if (any(iarr /= [1, 2])) stop 3
+
+    ! REAL - runtime value checks
+    rarr = [real :: [2], [3]]
+    if (any(rarr /= [2.0, 3.0])) stop 4
+    rarr = [real :: ([2]), ([3])]
+    if (any(rarr /= [2.0, 3.0])) stop 5
+    rarr = [real :: ((([2]))), [3]]
+    if (any(rarr /= [2.0, 3.0])) stop 6
+
+    ! COMPLEX - runtime value checks
+    carr = [complex :: [3], [4]]
+    if (any(carr /= [(3.0, 0.0), (4.0, 0.0)])) stop 7
+    carr = [complex :: ([3]), ([4])]
+    if (any(carr /= [(3.0, 0.0), (4.0, 0.0)])) stop 8
+    carr = [complex :: ((([3]))), [4]]
+    if (any(carr /= [(3.0, 0.0), (4.0, 0.0)])) stop 9
+
+    ! LOGICAL - runtime value checks
+    larr = [logical :: [.true.], [.false.]]
+    if (any(larr .neqv. [.true., .false.])) stop 10
+    larr = [logical :: ([.true.]), ([.false.])]
+    if (any(larr .neqv. [.true., .false.])) stop 11
+
+    ! CHARACTER - runtime value checks (PR 102417)
+    charr = [character(4) :: 'a', 'b', 'c']
+    if (any(charr /= ['a   ', 'b   ', 'c   '])) stop 12
+    charr = [character(4) :: ('a'), 'b', 'c']
+    if (any(charr /= ['a   ', 'b   ', 'c   '])) stop 13
+    charr = [[character(4) :: 'a', 'b', 'c']]
+    if (any(charr /= ['a   ', 'b   ', 'c   '])) stop 14
+
+    ! CHARACTER with nested constructors - length 8
+    charr8 = [character(8) :: 'x', 'y']
+    if (charr8(1) /= 'x       ') stop 15
+    if (charr8(2) /= 'y       ') stop 16
+
+    charr8 = [character(8) :: ['a', 'b']]
+    if (charr8(1) /= 'a       ') stop 17
+    if (charr8(2) /= 'b       ') stop 18
+
+    charr8 = [[character(8) :: ['a', 'b']]]
+    if (charr8(1) /= 'a       ') stop 19
+    if (charr8(2) /= 'b       ') stop 20
+
+    charr8 = [[[character(8) :: ['a', 'b']]]]
+    if (charr8(1) /= 'a       ') stop 21
+    if (charr8(2) /= 'b       ') stop 22
+
+    charr8 = [character(8) :: (x), (y)]
+    if (charr8(1) /= 'a       ') stop 23
+    if (charr8(2) /= 'b       ') stop 24
+
+    charr8 = [[character(8) :: (x), (y)]]
+    if (charr8(1) /= 'a       ') stop 25
+    if (charr8(2) /= 'b       ') stop 26
+
+    ! CHARACTER concatenation with parentheses (PR 107721 comment 14)
+    charr16_2 = [character(16) :: 'a' // 'c', 'b' // 'de']
+    if (charr16_2(1) /= 'ac              ') stop 101
+    if (charr16_2(2) /= 'bde             ') stop 102
+
+    charr16_2 = [character(16) :: 'a' // 'c', ('b' // 'de')]
+    if (charr16_2(1) /= 'ac              ') stop 103
+    if (charr16_2(2) /= 'bde             ') stop 104
+
+    charr16_2 = [character(16) :: ('a' // 'c'), 'b' // 'de']
+    if (charr16_2(1) /= 'ac              ') stop 105
+    if (charr16_2(2) /= 'bde             ') stop 106
+
+    ! CHARACTER concatenation after constructor - verify length 17
+    charr17 = [character(16) :: 'a' // 'c', 'b' // 'de'] // '|'
+    if (len(charr17) /= 17) stop 107
+    if (charr17(1) /= 'ac              |') stop 108
+    if (charr17(2) /= 'bde             |') stop 109
+
+    charr17 = [character(16) :: 'a' // 'c', ('b' // 'de')] // '|'
+    if (len(charr17) /= 17) stop 110
+    if (charr17(1) /= 'ac              |') stop 111
+    if (charr17(2) /= 'bde             |') stop 112
+
+    charr17 = [character(16) :: ('a' // 'c'), 'b' // 'de'] // '|'
+    if (len(charr17) /= 17) stop 113
+    if (charr17(1) /= 'ac              |') stop 114
+    if (charr17(2) /= 'bde             |') stop 115
+
+    ! CHARACTER - longer length 16
+    charr16 = [character(16) :: 'a', 'b', 'c']
+    if (charr16(1) /= 'a               ') stop 27
+    if (charr16(2) /= 'b               ') stop 28
+    if (charr16(3) /= 'c               ') stop 29
+
+    charr16 = [[character(16) :: 'a', 'b', 'c']]
+    if (charr16(1) /= 'a               ') stop 30
+    if (charr16(2) /= 'b               ') stop 31
+    if (charr16(3) /= 'c               ') stop 32
+
+    ! CHARACTER - truncation cases
+    charr8 = [character(8) :: 'abcdefghij', 'klmnopqrst']
+    if (charr8(1) /= 'abcdefgh') stop 33
+    if (charr8(2) /= 'klmnopqr') stop 34
+
+    charr8 = [[character(8) :: 'abcdefghij', 'klmnopqrst']]
+    if (charr8(1) /= 'abcdefgh') stop 35
+    if (charr8(2) /= 'klmnopqr') stop 36
+
+    ! Implied-do with parentheses
+    iarr = [integer :: (/(1.0*i, i=1, 2)/)]
+    if (any(iarr /= [1, 2])) stop 37
+    iarr = [integer :: ((/(1.0*i, i=1, 2)/))]
+    if (any(iarr /= [1, 2])) stop 38
+
+    ! Operations on parenthesized constructors
+    if (any([integer :: ([1.0])] ** 2 /= [1])) stop 39
+    if (any([real :: ([2]), [3]] ** 2 /= [4.0, 9.0])) stop 40
+    if (any([complex :: ([3])] ** 2 /= [(9.0, 0.0)])) stop 41
+
+    ! Type verification with CLASS(*) - ensure types are actually converted
+    res = [integer :: ([1.0])]
+    call verify_integer (res, 42)
+    deallocate (res)
+
+    res = [integer :: ([1.0]), ([2.0])]
+    call verify_integer (res, 43)
+    deallocate (res)
+
+    res = [real :: ([2]), [3]]
+    call verify_real (res, 44)
+    deallocate (res)
+
+    res = [complex :: ([3])]
+    call verify_complex (res, 45)
+    deallocate (res)
+
+    res = [logical :: ([.true.]), [.false.]]
+    call verify_logical (res, 46)
+    deallocate (res)
+
+contains
+
+    subroutine verify_integer (x, stopcode)
+        class(*), intent(in) :: x(:)
+        integer,  intent(in) :: stopcode
+        select type (x)
+        type is (integer)
+            ! Correct type
+        class default
+            stop stopcode
+        end select
+    end subroutine verify_integer
+
+    subroutine verify_real (x, stopcode)
+        class(*), intent(in) :: x(:)
+        integer,  intent(in) :: stopcode
+        select type (x)
+        type is (real)
+            ! Correct type
+        class default
+            stop stopcode
+        end select
+    end subroutine verify_real
+
+    subroutine verify_complex (x, stopcode)
+        class(*), intent(in) :: x(:)
+        integer,  intent(in) :: stopcode
+        select type (x)
+        type is (complex)
+            ! Correct type
+        class default
+            stop stopcode
+        end select
+    end subroutine verify_complex
+
+    subroutine verify_logical (x, stopcode)
+        class(*), intent(in) :: x(:)
+        integer,  intent(in) :: stopcode
+        select type (x)
+        type is (logical)
+            ! Correct type
+        class default
+            stop stopcode
+        end select
+    end subroutine verify_logical
+
+end program array_constructor_typespec_1
