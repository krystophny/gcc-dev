From da5c252c8252356e4eb32bead1c231e019f5a430 Mon Sep 17 00:00:00 2001
From: Christopher Albert <albert@tugraz.at>
Date: Tue, 17 Feb 2026 23:04:52 +0100
Subject: [PATCH] fortran: Avoid ICE in recursive allocatable deep copy
 [PR123947]

In structure_alloc_comps, the helper path for recursive allocatable arrays
was selected for any "seen" type, including mutually-recursive types.
That can drive problematic deep-copy wrapper generation and crash in
address-building code.

Limit this helper path to direct self-recursion only, and cache generated
element-copy helpers per derived type in non-coarray mode to avoid
regenerating equivalent wrappers repeatedly.

Also add a reduced regression testcase from PR123947.

	PR fortran/123947
	* fortran/trans-array.cc (copy_helper_wrappers): New static map.
	(structure_alloc_comps): Restrict recursive array helper path to
	direct self-recursion and reuse cached helper wrappers.
	* testsuite/gfortran.dg/pr123947.f90: New test.

Signed-off-by: Christopher Albert <albert@tugraz.at>
---
 gcc/fortran/trans-array.cc             | 39 ++++++++++++++++++--------
 gcc/testsuite/gfortran.dg/pr123947.f90 | 29 +++++++++++++++++++
 2 files changed, 57 insertions(+), 11 deletions(-)
 create mode 100644 gcc/testsuite/gfortran.dg/pr123947.f90

diff --git a/gcc/fortran/trans-array.cc b/gcc/fortran/trans-array.cc
index 6cddd80b8ae..8175f488927 100644
--- a/gcc/fortran/trans-array.cc
+++ b/gcc/fortran/trans-array.cc
@@ -10035,6 +10035,7 @@ enum {DEALLOCATE_ALLOC_COMP = 1, NULLIFY_ALLOC_COMP,
 static gfc_actual_arglist *pdt_param_list;
 static bool generating_copy_helper;
 static hash_set<gfc_symbol *> seen_derived_types;
+static hash_map<gfc_symbol *, tree> copy_helper_wrappers;
 
 /* Forward declaration of structure_alloc_comps for wrapper generator.  */
 static tree structure_alloc_comps (gfc_symbol *, tree, tree, int, int, int,
@@ -10332,6 +10333,8 @@ structure_alloc_comps (gfc_symbol * der_type, tree decl, tree dest,
 	   && seen_derived_types.contains (c->ts.u.derived))
 	  || (c->ts.type == BT_CLASS
 	      && seen_derived_types.contains (CLASS_DATA (c)->ts.u.derived));
+      bool direct_self_recursive
+	= (c->ts.type == BT_DERIVED && c->ts.u.derived == der_type);
       bool inside_wrapper = generating_copy_helper;
 
       bool is_pdt_type = IS_PDT (c);
@@ -11007,14 +11010,15 @@ structure_alloc_comps (gfc_symbol * der_type, tree decl, tree dest,
 					   false, false, NULL_TREE, NULL_TREE);
 	      gfc_add_expr_to_block (&fnblock, tmp);
 	    }
-      /* Special case: recursive allocatable array components require
-	 runtime helpers to avoid compile-time infinite recursion.  Generate
-	 a call to _gfortran_cfi_deep_copy_array with an element copy
-	 wrapper.  When inside a wrapper, reuse current_function_decl.  */
-      else if (c->attr.allocatable && c->as && cmp_has_alloc_comps && same_type
-	       && purpose == COPY_ALLOC_COMP && !c->attr.proc_pointer
-	       && !c->attr.codimension && !caf_in_coarray (caf_mode)
-	       && c->ts.type == BT_DERIVED && c->ts.u.derived != NULL)
+	  /* Special case: recursive allocatable array components require
+	     runtime helpers to avoid compile-time infinite recursion.  Generate
+	     a call to _gfortran_cfi_deep_copy_array with an element copy
+	     wrapper.  When inside a wrapper, reuse current_function_decl.  */
+	  else if (c->attr.allocatable && c->as && cmp_has_alloc_comps
+		   && direct_self_recursive
+		   && purpose == COPY_ALLOC_COMP && !c->attr.proc_pointer
+		   && !c->attr.codimension && !caf_in_coarray (caf_mode)
+		   && c->ts.type == BT_DERIVED && c->ts.u.derived != NULL)
 	    {
 	      tree copy_wrapper, call, dest_addr, src_addr, elem_type;
 	      tree helper_ptr_type;
@@ -11044,9 +11048,22 @@ structure_alloc_comps (gfc_symbol * der_type, tree decl, tree dest,
 		copy_wrapper
 		  = gfc_build_addr_expr (NULL_TREE, current_function_decl);
 	      else
-		copy_wrapper
-		  = generate_element_copy_wrapper (c->ts.u.derived, elem_type,
-						   purpose, caf_mode);
+		{
+		  tree *cached = NULL;
+		  if (caf_mode == 0)
+		    cached = copy_helper_wrappers.get (c->ts.u.derived);
+		  if (cached)
+		    copy_wrapper = *cached;
+		  else
+		    {
+		      copy_wrapper
+			= generate_element_copy_wrapper (c->ts.u.derived,
+							 elem_type, purpose,
+							 caf_mode);
+		      if (caf_mode == 0)
+			copy_helper_wrappers.put (c->ts.u.derived, copy_wrapper);
+		    }
+		}
 	      copy_wrapper = fold_convert (helper_ptr_type, copy_wrapper);
 
 	      /* Build addresses of descriptors.  */
diff --git a/gcc/testsuite/gfortran.dg/pr123947.f90 b/gcc/testsuite/gfortran.dg/pr123947.f90
new file mode 100644
index 00000000000..30a21864f65
--- /dev/null
+++ b/gcc/testsuite/gfortran.dg/pr123947.f90
@@ -0,0 +1,29 @@
+! { dg-do compile }
+!
+! PR fortran/123947
+! Reduced from Bugzilla attachment 63564.
+! Used to ICE in gfc_build_addr_expr from trans-array deep-copy handling.
+!
+TYPE TY0
+TYPE(TY0), ALLOCATABLE :: NODE0(:)
+TYPE(TY), ALLOCATABLE :: NODE4(:)
+TYPE(TY1),ALLOCATABLE :: NODE7(:)
+END TYPE
+TYPE TY1
+INTEGER,ALLOCATABLE :: II(:)
+TYPE(TY0) :: NODE2(4)
+TYPE(TY1), ALLOCATABLE :: NODE1(:)
+TYPE(TY),ALLOCATABLE :: NODE5(:)
+END TYPE
+TYPE TY
+INTEGER,ALLOCATABLE :: II(:)
+TYPE(TY1) :: NODE3(4)
+TYPE(TY),ALLOCATABLE :: NODE6(:)
+END TYPE
+TYPE BASE
+TYPE(TY),ALLOCATABLE :: OBJ(:)
+END TYPE
+TYPE(BASE):: OBJ_BASE
+ALLOCATE(OBJ_BASE%OBJ(2)%NODE6(2)%NODE6(3))
+ALLOCATE(OBJ_BASE%OBJ(2)%NODE6(2)%NODE6(2)%NODE6(3))
+END
-- 
2.53.0

