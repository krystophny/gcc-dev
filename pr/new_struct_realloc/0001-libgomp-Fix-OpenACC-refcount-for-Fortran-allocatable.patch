From 935e802e4e6a5044eb9b58ccff3aab970fdb0343 Mon Sep 17 00:00:00 2001
From: Christopher Albert <albert@tugraz.at>
Date: Wed, 24 Dec 2025 00:04:32 +0100
Subject: [PATCH] libgomp: Fix OpenACC refcount for Fortran allocatable array
 descriptors

For Fortran allocatable arrays, TO_PSET + POINTER mapping groups create
multiple tgt->list entries that reference the same splay tree key (the
array descriptor address).  gomp_map_vars_internal increments refcount
once per list entry, resulting in refcount=2 for a two-entry group.
However, exit_data only sends one RELEASE mapping per descriptor,
decrementing both refcount and dynamic_refcount by 1 each.

The original code incremented dynamic_refcount for every list entry,
causing an asymmetry: refcount=2, dynamic_refcount=2 after enter_data,
but only decrementing by 1 each on exit_data, leaving refcount=1,
dynamic_refcount=1.  This caused stale mappings in repeated
allocate/enter/exit/deallocate cycles, leading to illegal memory access
on iteration 2 when arrays got reallocated at different addresses.

The fix tracks duplicate keys in goacc_enter_data_internal and:
1. Only increments dynamic_refcount once per unique key
2. Decrements refcount for duplicates to compensate

libgomp/ChangeLog:

	* oacc-mem.c (goacc_enter_data_internal): Track duplicate splay
	tree keys in tgt->list and adjust refcount/dynamic_refcount to
	maintain enter/exit symmetry for TO_PSET + POINTER mapping groups.
	* testsuite/libgomp.oacc-fortran/allocatable-component-realloc-1.f90:
	New test.

Signed-off-by: Philipp Orsini <orsini@cp.tum.de>
Signed-off-by: Christopher Albert <albert@tugraz.at>
---
 libgomp/oacc-mem.c                            | 26 ++++++++-
 .../allocatable-component-realloc-1.f90       | 56 +++++++++++++++++++
 2 files changed, 81 insertions(+), 1 deletion(-)
 create mode 100644 libgomp/testsuite/libgomp.oacc-fortran/allocatable-component-realloc-1.f90

diff --git a/libgomp/oacc-mem.c b/libgomp/oacc-mem.c
index 5b8ba7e1072..1e7f61847ba 100644
--- a/libgomp/oacc-mem.c
+++ b/libgomp/oacc-mem.c
@@ -1281,11 +1281,35 @@ goacc_enter_data_internal (struct gomp_device_descr *acc_dev, size_t mapnum,
 
 	  gomp_mutex_lock (&acc_dev->lock);
 
+	  /* For Fortran allocatable arrays, TO_PSET + POINTER mapping groups
+	     create multiple tgt->list entries that reference the same splay
+	     tree key (the array descriptor address).  gomp_map_vars_internal
+	     increments refcount once per list entry, resulting in refcount=2
+	     for a two-entry group.  However, exit_data only sends one RELEASE
+	     mapping per descriptor, decrementing both refcount and
+	     dynamic_refcount by 1 each.  To maintain enter/exit symmetry, we
+	     increment dynamic_refcount only once per unique key and decrement
+	     refcount to compensate for duplicates.  */
+	  splay_tree_key prev_key = NULL;
 	  for (size_t j = 0; j < tgt->list_count; j++)
 	    {
 	      n = tgt->list[j].key;
 	      if (n && !tgt->list[j].is_attach)
-		n->dynamic_refcount++;
+		{
+		  if (n != prev_key)
+		    {
+		      n->dynamic_refcount++;
+		      prev_key = n;
+		    }
+		  else
+		    {
+		      /* Duplicate key: adjust refcount down to compensate
+			 for gomp_map_vars_internal counting it twice.  */
+		      if (n->refcount != REFCOUNT_INFINITY
+			  && n->refcount != REFCOUNT_ACC_MAP_DATA)
+			n->refcount--;
+		    }
+		}
 	    }
 	}
 
diff --git a/libgomp/testsuite/libgomp.oacc-fortran/allocatable-component-realloc-1.f90 b/libgomp/testsuite/libgomp.oacc-fortran/allocatable-component-realloc-1.f90
new file mode 100644
index 00000000000..f5735e9287d
--- /dev/null
+++ b/libgomp/testsuite/libgomp.oacc-fortran/allocatable-component-realloc-1.f90
@@ -0,0 +1,56 @@
+! { dg-do run }
+! { dg-skip-if "" { *-*-* } { "*" } { "-DACC_MEM_SHARED=0" } }
+!
+! Test that repeated allocate/enter/exit/deallocate cycles work correctly
+! with derived types containing allocatable components and TO_PSET+POINTER
+! mapping groups.  The bug manifested when the first parallel loop did NOT
+! use the derived type component, creating a refcount asymmetry that caused
+! stale mappings on iteration 2.
+
+module m
+  use iso_fortran_env, only: dp => real64
+  implicit none
+  type :: t
+    real(dp), allocatable :: c(:)
+  end type
+end module
+
+program p
+  use m
+  implicit none
+  type(t) :: s
+  real(dp), allocatable :: w1(:,:,:), w2(:,:,:)
+  integer :: i, iter
+
+  do iter = 1, 3
+    allocate(s%c(8), w1(8,8,0:1), w2(8,8,0:1))
+
+    s%c = 0.0_dp
+    w1 = 1.0_dp
+    w2 = 2.0_dp
+
+    !$acc enter data create(s%c, w2) copyin(w1)
+
+    ! First loop WITHOUT derived type component
+    !$acc parallel loop present(w1, w2)
+    do i = 1, 8
+      w2(1,i,0) = w1(1,i,0)
+    end do
+
+    ! Second loop WITH derived type component
+    ! (this ordering triggers the bug)
+    !$acc parallel loop present(w1, s%c)
+    do i = 1, 8
+      s%c(i) = w1(1,i,0)
+    end do
+
+    !$acc exit data copyout(s%c) delete(w1, w2)
+
+    ! Verify results
+    do i = 1, 8
+      if (abs(s%c(i) - 1.0_dp) > 1.0e-10_dp) stop 1
+    end do
+
+    deallocate(w1, w2, s%c)
+  end do
+end program
-- 
2.52.0

