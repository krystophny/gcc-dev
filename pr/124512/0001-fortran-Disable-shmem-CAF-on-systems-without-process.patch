From 8e442e57d3a3476fa3c4c5936ad588d74b6b6959 Mon Sep 17 00:00:00 2001
From: Christopher Albert <albert@tugraz.at>
Date: Wed, 18 Mar 2026 23:48:14 +0100
Subject: [PATCH] fortran: Disable shmem CAF on systems without process-shared
 pthread support [PR124512]

The shared-memory coarray implementation requires pthread_mutexattr_setpshared
and pthread_condattr_setpshared, which are not available on all POSIX systems
(notably NetBSD).  Add a configure check for pthread_mutexattr_setpshared and
disable ENABLE_CAF_SHMEM when it is absent.

Also add aarch64*-*-netbsd* to the host detection pattern in config.host so
that driver-aarch64.o is linked, matching the existing arm*-*-netbsd* pattern.

	PR fortran/124512

gcc/ChangeLog:

	* config.host: Add aarch64*-*-netbsd* to host_detect_local_cpu
	pattern.

libgfortran/ChangeLog:

	* configure.ac: Check for pthread_mutexattr_setpshared before
	enabling shmem CAF.
	* configure: Regenerate.

Signed-off-by: Christopher Albert <albert@tugraz.at>
---
 gcc/config.host          |  2 +-
 libgfortran/configure    | 16 ++++++++++++++++
 libgfortran/configure.ac | 10 ++++++++++
 3 files changed, 27 insertions(+), 1 deletion(-)

diff --git a/gcc/config.host b/gcc/config.host
index 8b809a8d5dd..82a5da67670 100644
--- a/gcc/config.host
+++ b/gcc/config.host
@@ -100,7 +100,7 @@ esac
 
 case ${host} in
   aarch64*-*-freebsd* | aarch64*-*-linux* | aarch64*-*-fuchsia* |\
-  aarch64*-*-darwin*)
+  aarch64*-*-darwin* | aarch64*-*-netbsd*)
     case ${target} in
       aarch64*-*-*)
 	host_extra_gcc_objs="driver-aarch64.o"
diff --git a/libgfortran/configure b/libgfortran/configure
index d0ebed7ea84..fa27c308399 100755
--- a/libgfortran/configure
+++ b/libgfortran/configure
@@ -18413,6 +18413,22 @@ ac_compile='$CC -c $CFLAGS $CPPFLAGS conftest.$ac_ext >&5'
 ac_link='$CC -o conftest$ac_exeext $CFLAGS $CPPFLAGS $LDFLAGS conftest.$ac_ext $LIBS >&5'
 ac_compiler_gnu=$ac_cv_c_compiler_gnu
 
+# Shmem CAF requires process-shared pthread mutexes and conditions.
+if test x$enable_caf_shmem = xtrue; then
+  save_CFLAGS="$CFLAGS"
+  save_LIBS="$LIBS"
+  CFLAGS="$CFLAGS $PTHREAD_CFLAGS"
+  LIBS="$LIBS $PTHREAD_LIBS"
+ac_fn_c_check_func "$LINENO" "pthread_mutexattr_setpshared" "ac_cv_func_pthread_mutexattr_setpshared"
+if test "x$ac_cv_func_pthread_mutexattr_setpshared" = xyes; then :
+
+else
+  enable_caf_shmem=false
+fi
+
+  CFLAGS="$save_CFLAGS"
+  LIBS="$save_LIBS"
+fi
 
  if test x$enable_caf_shmem = xtrue; then
   ENABLE_CAF_SHMEM_TRUE=
diff --git a/libgfortran/configure.ac b/libgfortran/configure.ac
index 530d15f0152..5b04b6169f0 100644
--- a/libgfortran/configure.ac
+++ b/libgfortran/configure.ac
@@ -351,6 +351,16 @@ AX_PTHREAD([
   ], [
   enable_caf_shmem=false
   ])
+# Shmem CAF requires process-shared pthread mutexes and conditions.
+if test x$enable_caf_shmem = xtrue; then
+  save_CFLAGS="$CFLAGS"
+  save_LIBS="$LIBS"
+  CFLAGS="$CFLAGS $PTHREAD_CFLAGS"
+  LIBS="$LIBS $PTHREAD_LIBS"
+  AC_CHECK_FUNC([pthread_mutexattr_setpshared], [], [enable_caf_shmem=false])
+  CFLAGS="$save_CFLAGS"
+  LIBS="$save_LIBS"
+fi
 AM_CONDITIONAL([ENABLE_CAF_SHMEM], [test x$enable_caf_shmem = xtrue])
 
 # Check strerror_r, cannot be above as versions with two and three arguments exist
-- 
