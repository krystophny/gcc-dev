From 18c3b48f5e197c13c3ed6cee7512e93011d0cc34 Mon Sep 17 00:00:00 2001
From: Christopher Albert <albert@tugraz.at>
Date: Tue, 31 Mar 2026 08:08:01 +0200
Subject: [PATCH] fortran: Fix heap-use-after-free in resolve_charlen [PR79524]

When compiling invalid code containing an array constructor with a
variable-length character typespec (e.g., [character(n) :: 'x', 'y']),
the charlen created for character(n) references the implicitly typed
symbol n via a symtree pointer.  When the declaration is rejected,
gfc_undo_symbols frees n's symtree, but the charlen survives on the
namespace cl_list.  Later, resolve_charlen attempts to resolve the
dangling expression, triggering a heap-use-after-free in
check_host_association.

Fix by detecting dangling symtree references before resolution.
The new helper verifies that a charlen expression's symtree is still
present in the namespace's symtree BBT; if not, the expression is
discarded and resolution fails gracefully.

gcc/fortran/ChangeLog:

	PR fortran/79524
	* resolve.cc (symtree_in_bbt): New helper to check whether a
	symtree pointer is still in a namespace BBT.
	(charlen_has_dangling_reference): New helper to detect charlen
	expressions referencing freed symtrees.
	(resolve_charlen): Detect and discard charlen expressions with
	dangling symtree references before attempting resolution.

gcc/testsuite/ChangeLog:

	PR fortran/79524
	* gfortran.dg/pr79524.f90: New test.

Signed-off-by: Christopher Albert <albert@tugraz.at>
---
 gcc/fortran/resolve.cc                | 70 +++++++++++++++++++++++++++
 gcc/testsuite/gfortran.dg/pr79524.f90 | 11 +++++
 2 files changed, 81 insertions(+)
 create mode 100644 gcc/testsuite/gfortran.dg/pr79524.f90

diff --git a/gcc/fortran/resolve.cc b/gcc/fortran/resolve.cc
index 767bbdea114..b52b367f3ec 100644
--- a/gcc/fortran/resolve.cc
+++ b/gcc/fortran/resolve.cc
@@ -14868,6 +14868,65 @@ resolve_index_expr (gfc_expr *e)
 }
 
 
+/* Return true if the symtree node ST is reachable from the BBT rooted
+   at ROOT.  Used to detect dangling symtree pointers left behind by
+   gfc_undo_symbols when a rejected statement's charlen expression
+   references a symbol whose symtree has already been freed.  */
+
+static bool
+symtree_in_bbt (gfc_symtree *root, gfc_symtree *st)
+{
+  if (root == NULL)
+    return false;
+  if (root == st)
+    return true;
+  return symtree_in_bbt (root->left, st) || symtree_in_bbt (root->right, st);
+}
+
+
+/* Return true if E (or any sub-expression of E) contains a symtree pointer
+   that is no longer reachable from the namespace BBT.  This detects dangling
+   references left behind when reject_statement calls gfc_undo_symbols but
+   charlen nodes on the namespace cl_list survive (PR79524).  */
+
+static bool
+expr_has_dangling_symtree (gfc_expr *e, gfc_symtree *sym_root)
+{
+  if (e == NULL)
+    return false;
+
+  if ((e->expr_type == EXPR_VARIABLE || e->expr_type == EXPR_FUNCTION)
+      && e->symtree != NULL
+      && !symtree_in_bbt (sym_root, e->symtree))
+    return true;
+
+  /* Recurse into operator sub-expressions.  */
+  if (e->expr_type == EXPR_OP)
+    return expr_has_dangling_symtree (e->value.op.op1, sym_root)
+	   || expr_has_dangling_symtree (e->value.op.op2, sym_root);
+
+  /* Recurse into function actual arguments.  */
+  if (e->expr_type == EXPR_FUNCTION)
+    for (gfc_actual_arglist *a = e->value.function.actual; a; a = a->next)
+      if (expr_has_dangling_symtree (a->expr, sym_root))
+	return true;
+
+  return false;
+}
+
+
+/* Return true if CL->length contains any dangling symtree references.  */
+
+static bool
+charlen_has_dangling_reference (gfc_charlen *cl)
+{
+  if (cl->length == NULL)
+    return false;
+
+  return expr_has_dangling_symtree (cl->length, gfc_current_ns->sym_root);
+}
+
+
 /* Resolve a charlen structure.  */
 
 static bool
@@ -14883,6 +14942,17 @@ resolve_charlen (gfc_charlen *cl)
   saved_specification_expr = specification_expr;
   specification_expr = true;
 
+  /* Detect charlen expressions left dangling by rejected statements
+     (PR79524).  The symtree has been freed by gfc_undo_symbols; resolve
+     would dereference freed memory.  Discard the expression and fail.  */
+  if (charlen_has_dangling_reference (cl))
+    {
+      gfc_free_expr (cl->length);
+      cl->length = NULL;
+      specification_expr = saved_specification_expr;
+      return false;
+    }
+
   if (cl->length_from_typespec)
     {
       if (!gfc_resolve_expr (cl->length))
diff --git a/gcc/testsuite/gfortran.dg/pr79524.f90 b/gcc/testsuite/gfortran.dg/pr79524.f90
new file mode 100644
index 00000000000..06ae1c38025
--- /dev/null
+++ b/gcc/testsuite/gfortran.dg/pr79524.f90
@@ -0,0 +1,11 @@
+! { dg-do compile }
+! PR fortran/79524 - heap-use-after-free in resolve_charlen
+! The array constructor typespec character(n) creates a charlen on the
+! namespace cl_list whose length expression references the implicitly typed
+! symbol n.  When the declaration is rejected, gfc_undo_symbols frees n's
+! symtree, but the charlen survives.  resolve_charlen then crashed
+! dereferencing the dangling symtree pointer.
+program p
+   character(*), parameter :: z(2) = [character(n) :: 'x', 'y'] ! { dg-error "Cannot initialize parameter array" }
+   character(*), parameter :: w(2) = [character(n+1) :: 'a', 'b'] ! { dg-error "Cannot initialize parameter array" }
+end
-- 
