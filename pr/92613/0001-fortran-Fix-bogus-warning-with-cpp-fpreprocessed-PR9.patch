From cd3aa903c5cdd47e2ae52ae7bbab18f57184a9c8 Mon Sep 17 00:00:00 2001
From: Christopher Albert <albert@tugraz.at>
Date: Thu, 4 Dec 2025 14:08:10 +0100
Subject: [PATCH] fortran: Fix bogus warning with -cpp -fpreprocessed [PR92613]

When compiling already-preprocessed Fortran code with '-cpp -fpreprocessed',
gfortran incorrectly emits "missing terminating ' character" warnings for
apostrophes in Fortran comments like "! it's good!".

The root cause is that the C preprocessor (libcpp) does not understand
Fortran comments (which start with !) and incorrectly interprets
apostrophes in comments as unterminated character literals.  When
'-fpreprocessed' is used, the input has already been through the
preprocessor, so running it through libcpp again is unnecessary and
causes these bogus warnings.

This patch fixes the issue by skipping libcpp initialization and
tokenization when both '-cpp' and '-fpreprocessed' are specified.
The already-preprocessed source file is loaded directly instead.

	PR fortran/92613

gcc/fortran/ChangeLog:

	* cpp.cc (gfc_cpp_preprocess): Return false early when
	flag_preprocessed is set to skip libcpp tokenization.
	* f95-lang.cc (gfc_init): Skip libcpp initialization when
	flag_preprocessed is set, even if -cpp was specified.
	* scanner.cc (gfc_new_file): Handle gfc_cpp_preprocess returning
	false by loading source file directly.

gcc/testsuite/ChangeLog:

	* gfortran.dg/pr92613.f90: New test.

Signed-off-by: Christopher Albert <albert@tugraz.at>
---
 gcc/fortran/cpp.cc                    |  8 ++++++++
 gcc/fortran/f95-lang.cc               |  8 ++++++--
 gcc/fortran/scanner.cc                | 14 +++++++++++---
 gcc/testsuite/gfortran.dg/pr92613.f90 | 15 +++++++++++++++
 4 files changed, 40 insertions(+), 5 deletions(-)
 create mode 100644 gcc/testsuite/gfortran.dg/pr92613.f90

diff --git a/gcc/fortran/cpp.cc b/gcc/fortran/cpp.cc
index 15ecc7dd5fa..dbba61a31e5 100644
--- a/gcc/fortran/cpp.cc
+++ b/gcc/fortran/cpp.cc
@@ -679,6 +679,14 @@ gfc_cpp_preprocess (const char *source_file)
   if (!gfc_cpp_enabled ())
     return false;
 
+  /* PR fortran/92613: If input is already preprocessed, skip libcpp
+     tokenization entirely.  The C preprocessor does not understand
+     Fortran comments (which start with !) and would incorrectly warn
+     about apostrophes in comments like "! it's good".  Just load the
+     already-preprocessed source directly.  */
+  if (gfc_option.flag_preprocessed)
+    return false;
+
   cpp_change_file (cpp_in, LC_RENAME, source_file);
 
   if (cpp_option->traditional)
diff --git a/gcc/fortran/f95-lang.cc b/gcc/fortran/f95-lang.cc
index 06ffc67357b..39e1fb04650 100644
--- a/gcc/fortran/f95-lang.cc
+++ b/gcc/fortran/f95-lang.cc
@@ -274,7 +274,11 @@ gfc_be_parse_file (void)
 static bool
 gfc_init (void)
 {
-  if (!gfc_cpp_enabled ())
+  /* PR fortran/92613: When input is already preprocessed (-fpreprocessed),
+     skip libcpp initialization even if -cpp was specified.  The combination
+     -cpp -fpreprocessed means the input was preprocessed separately and
+     should be loaded directly without running it through libcpp again.  */
+  if (!gfc_cpp_enabled () || gfc_option.flag_preprocessed)
     {
       linemap_add (line_table, LC_ENTER, false, gfc_source_file, 1);
       linemap_add (line_table, LC_RENAME, false, special_fname_builtin (), 0);
@@ -285,7 +289,7 @@ gfc_init (void)
   gfc_init_decl_processing ();
   gfc_static_ctors = NULL_TREE;
 
-  if (gfc_cpp_enabled ())
+  if (gfc_cpp_enabled () && !gfc_option.flag_preprocessed)
     gfc_cpp_init ();
 
   gfc_init_1 ();
diff --git a/gcc/fortran/scanner.cc b/gcc/fortran/scanner.cc
index cd9c5283515..292bb09d61a 100644
--- a/gcc/fortran/scanner.cc
+++ b/gcc/fortran/scanner.cc
@@ -2775,9 +2775,17 @@ gfc_new_file (void)
 
   if (gfc_cpp_enabled ())
     {
-      gfc_cpp_preprocess (gfc_source_file);
-      if (!gfc_cpp_preprocess_only ())
-	load_file (gfc_cpp_temporary_file (), gfc_source_file, true);
+      /* PR fortran/92613: gfc_cpp_preprocess returns false when input
+	 is already preprocessed (-fpreprocessed), in which case we
+	 load the source file directly instead of running it through
+	 libcpp's tokenizer (which doesn't understand Fortran).  */
+      if (gfc_cpp_preprocess (gfc_source_file))
+	{
+	  if (!gfc_cpp_preprocess_only ())
+	    load_file (gfc_cpp_temporary_file (), gfc_source_file, true);
+	}
+      else
+	load_file (gfc_source_file, NULL, true);
     }
   else
     load_file (gfc_source_file, NULL, true);
diff --git a/gcc/testsuite/gfortran.dg/pr92613.f90 b/gcc/testsuite/gfortran.dg/pr92613.f90
new file mode 100644
index 00000000000..db7ff6004dd
--- /dev/null
+++ b/gcc/testsuite/gfortran.dg/pr92613.f90
@@ -0,0 +1,15 @@
+# 1 "<test>"
+# 1 "<built-in>"
+# 1 "<command-line>"
+# 1 "<test>"
+! PR fortran/92613
+! Test that quotes in comments do not cause bogus warnings
+! when compiling preprocessed Fortran with -cpp -fpreprocessed.
+! { dg-do compile }
+! { dg-options "-cpp -fpreprocessed" }
+program test
+  implicit none
+  write(6,*) 'hello'
+! it's good! { dg-bogus "missing terminating" }
+! This comment has a "quote" too { dg-bogus "missing terminating" }
+end program
-- 
2.52.0

