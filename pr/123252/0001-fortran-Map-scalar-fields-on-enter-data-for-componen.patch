From f97452a16ea94c0dc0327fb4c532cc3003a0b34e Mon Sep 17 00:00:00 2001
From: Christopher Albert <albert@tugraz.at>
Date: Tue, 23 Dec 2025 10:15:54 +0100
Subject: [PATCH] fortran: Map scalar fields on enter data for components
 [PR123252]

When enter data maps only an allocatable component of a derived type
(e.g., c%arr), the scalar fields of the parent type (e.g., c%flag,
c%n) must also be mapped so they are available on the device in
subsequent parallel regions.

Without this fix, accessing scalar fields like loop bounds or flags
inside a parallel region would use uninitialized device memory, since
only the explicitly mapped component data was copied.

The fix detects when an allocatable component is being mapped for
enter data and synthesizes additional map(to:) clauses for all scalar
fields of the parent derived type.  This applies to both OpenACC
(OACC_ENTER_DATA) and OpenMP (OMP_TARGET_ENTER_DATA).

Limitations: The fix handles simple cases like c%arr and nested
component access like a%b%arr, but skips complex cases with array
indexing in the path (e.g., a(1)%b%arr) to avoid ICEs.

	PR fortran/123252

gcc/fortran/ChangeLog:

	* trans-openmp.cc (gfc_trans_omp_clauses): For enter data,
	also map scalar fields of derived type when mapping an
	allocatable component.  Handle nested components and add
	BT_CHARACTER to supported scalar types.

gcc/testsuite/ChangeLog:

	* gfortran.dg/goacc/pr123252.f90: New test.

Signed-off-by: Christopher Albert <albert@tugraz.at>
---
 gcc/fortran/trans-openmp.cc                  | 102 +++++++++++++++++++
 gcc/testsuite/gfortran.dg/goacc/pr123252.f90 |  38 +++++++
 2 files changed, 140 insertions(+)
 create mode 100644 gcc/testsuite/gfortran.dg/goacc/pr123252.f90

diff --git a/gcc/fortran/trans-openmp.cc b/gcc/fortran/trans-openmp.cc
index d7f3c281823..1940779d0ab 100644
--- a/gcc/fortran/trans-openmp.cc
+++ b/gcc/fortran/trans-openmp.cc
@@ -4976,6 +4976,108 @@ gfc_trans_omp_clauses (stmtblock_t *block, gfc_omp_clauses *clauses,
 	      else
 		sorry_at (gfc_get_location (&n->where), "unhandled expression");
 
+	      /* For enter data on allocatable components, also map scalar
+		 fields so they are available on the device.  */
+	      if ((op == EXEC_OACC_ENTER_DATA || op == EXEC_OMP_TARGET_ENTER_DATA)
+		  && n->expr && n->expr->ref
+		  && lastref && lastref->type == REF_ARRAY)
+		{
+		  gfc_ref *parent_ref = NULL;
+		  gfc_ref *mapped_ref = NULL;
+
+		  /* Find the component ref before the array ref.  */
+		  for (gfc_ref *ref = n->expr->ref; ref; ref = ref->next)
+		    if (ref->type == REF_COMPONENT)
+		      {
+			parent_ref = mapped_ref;
+			mapped_ref = ref;
+		      }
+
+		  if (mapped_ref != NULL)
+		    {
+		      gfc_symbol *parent_sym;
+		      tree base;
+
+		      if (parent_ref != NULL)
+			{
+			  /* Skip if path to parent has array refs.  */
+			  bool has_array_ref = false;
+			  for (gfc_ref *ref = n->expr->ref; ref != mapped_ref;
+			       ref = ref->next)
+			    if (ref->type == REF_ARRAY)
+			      {
+				has_array_ref = true;
+				break;
+			      }
+			  if (has_array_ref)
+			    goto finalize_map_clause;
+
+			  parent_sym = parent_ref->u.c.component->ts.u.derived;
+			  /* Build base expression up to parent component.  */
+			  gfc_se base_se;
+			  gfc_init_se (&base_se, NULL);
+			  base_se.expr = gfc_maybe_dereference_var (n->sym, decl);
+			  for (gfc_ref *ref = n->expr->ref; ref != mapped_ref;
+			       ref = ref->next)
+			    if (ref->type == REF_COMPONENT)
+			      gfc_conv_component_ref (&base_se, ref);
+			  base = base_se.expr;
+			}
+		      else
+			{
+			  /* Skip if first ref is an array ref.  */
+			  if (n->expr->ref->type == REF_ARRAY)
+			    goto finalize_map_clause;
+			  parent_sym = n->sym->ts.u.derived;
+			  base = gfc_maybe_dereference_var (n->sym, decl);
+			}
+
+		      if (parent_sym == NULL)
+			goto finalize_map_clause;
+
+		      gfc_component *mapped_comp = mapped_ref->u.c.component;
+
+		      for (gfc_component *comp = parent_sym->components;
+			   comp; comp = comp->next)
+			{
+			  /* Skip the component being explicitly mapped.  */
+			  if (comp == mapped_comp)
+			    continue;
+
+			  /* Skip pointer, allocatable, and array components.  */
+			  if (comp->attr.pointer || comp->attr.allocatable
+			      || comp->attr.dimension)
+			    continue;
+
+			  /* Only map scalar fields.  */
+			  if (comp->ts.type != BT_INTEGER
+			      && comp->ts.type != BT_REAL
+			      && comp->ts.type != BT_LOGICAL
+			      && comp->ts.type != BT_COMPLEX
+			      && comp->ts.type != BT_CHARACTER)
+			    continue;
+
+			  /* Ensure backend_decl exists.  */
+			  if (comp->backend_decl == NULL_TREE)
+			    gfc_get_derived_type (parent_sym);
+
+			  if (comp->backend_decl == NULL_TREE)
+			    continue;
+
+			  tree field = comp->backend_decl;
+			  tree ftype = TREE_TYPE (field);
+			  tree cref = fold_build3_loc (input_location,
+						       COMPONENT_REF, ftype,
+						       base, field, NULL_TREE);
+			  tree c = build_omp_clause (map_loc, OMP_CLAUSE_MAP);
+			  OMP_CLAUSE_SET_MAP_KIND (c, GOMP_MAP_TO);
+			  OMP_CLAUSE_DECL (c) = cref;
+			  OMP_CLAUSE_SIZE (c) = TYPE_SIZE_UNIT (ftype);
+			  omp_clauses = gfc_trans_add_clause (c, omp_clauses);
+			}
+		    }
+		}
+
 	      finalize_map_clause:
 
 	      omp_clauses = gfc_trans_add_clause (node, omp_clauses);
diff --git a/gcc/testsuite/gfortran.dg/goacc/pr123252.f90 b/gcc/testsuite/gfortran.dg/goacc/pr123252.f90
new file mode 100644
index 00000000000..02f92a812fb
--- /dev/null
+++ b/gcc/testsuite/gfortran.dg/goacc/pr123252.f90
@@ -0,0 +1,38 @@
+! { dg-do compile }
+! { dg-options "-O2 -fopenacc -fdump-tree-omplower" }
+!
+! PR fortran/123252
+! When OpenACC enter data maps only an allocatable component, scalar
+! fields of the derived type must also be mapped so they are available
+! on the device.
+
+program pr123252
+  implicit none
+
+  type :: container_t
+    real(8), allocatable :: arr(:)
+    logical :: flag
+    integer :: n
+  end type container_t
+
+  type(container_t) :: c
+  integer :: i
+
+  c%n = 8
+  c%flag = .true.
+  allocate(c%arr(c%n))
+
+  !$acc enter data copyin(c%arr(1:c%n))
+
+  !$acc parallel loop present(c%arr)
+  do i = 1, c%n
+    if (c%flag) then
+      c%arr(i) = c%arr(i) + 1.0d0
+    end if
+  end do
+  !$acc end parallel loop
+end program pr123252
+
+! Verify scalar fields are mapped alongside the allocatable component.
+! { dg-final { scan-tree-dump "map\\(to:c\\.flag" "omplower" } }
+! { dg-final { scan-tree-dump "map\\(to:c\\.n" "omplower" } }
-- 
